{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://saagar.invalid/etp/licensing/etp-licence-envelope-v1.schema.json",
  "title": "ETP signed licence envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "keyId", "algorithm", "payload", "signature"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "keyId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,31}$" },
    "algorithm": { "const": "ES256-P1363" },
    "payload": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,87382}$" },
    "signature": { "type": "string", "pattern": "^[A-Za-z0-9_-]{86}$" }
  }
}
