{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://saagar.invalid/etp/licensing/etp-licence-payload-v1.schema.json",
  "title": "ETP licence payload v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "licenseId",
    "productId",
    "storeId",
    "deviceId",
    "installationId",
    "issuedAtUtc",
    "licenseType",
    "features",
    "expiresAtUtc",
    "replacementFor"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "licenseId": { "type": "string", "pattern": "^LIC-[A-Z0-9-]{6,40}$" },
    "productId": { "const": "SAAGAR-ETP-REPORTING-WINDOWS" },
    "storeId": { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9_-]{1,31}$" },
    "deviceId": { "type": "string", "pattern": "^ETP-[A-Z2-7]{4}-[A-Z2-7]{4}-[A-Z2-7]{4}$" },
    "installationId": { "type": "string", "format": "uuid" },
    "issuedAtUtc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "licenseType": { "const": "PerpetualDevice" },
    "features": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_.-]{0,63}$" }
    },
    "expiresAtUtc": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" }
      ]
    },
    "replacementFor": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "pattern": "^LIC-[A-Z0-9-]{6,40}$" }
      ]
    }
  }
}
