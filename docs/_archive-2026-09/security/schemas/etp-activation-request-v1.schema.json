{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://saagar.invalid/etp/licensing/etp-activation-request-v1.schema.json",
  "title": "ETP activation request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "requestId",
    "productId",
    "storeId",
    "deviceId",
    "installationId",
    "createdAtUtc",
    "applicationVersion",
    "requestNonce"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "requestId": { "type": "string", "format": "uuid" },
    "productId": { "const": "SAAGAR-ETP-REPORTING-WINDOWS" },
    "storeId": { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9_-]{1,31}$" },
    "deviceId": { "type": "string", "pattern": "^ETP-[A-Z2-7]{4}-[A-Z2-7]{4}-[A-Z2-7]{4}$" },
    "installationId": { "type": "string", "format": "uuid" },
    "createdAtUtc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "applicationVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?$" },
    "requestNonce": { "type": "string", "pattern": "^[A-Za-z0-9_-]{22}$" }
  }
}
