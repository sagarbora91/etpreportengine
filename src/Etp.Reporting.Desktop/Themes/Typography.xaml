<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 1.12 type scale (ETP-DESIGN-SYSTEM.md section 3). Brushes are DynamicResource so high contrast and later
         token changes reach styled text (CS-09). Views set Style, never FontSize/FontWeight (T1); SemiBold is the only
         emphasis (T3); 12 is the floor. PageTitleText is 20: the shell header title, not repeated in a view (T2). -->
    <Style x:Key="DisplayText" TargetType="TextBlock"><Setter Property="FontFamily" Value="Segoe UI Variable Display"/><Setter Property="FontSize" Value="32"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/><Setter Property="LineHeight" Value="38"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <Style x:Key="PageTitleText" TargetType="TextBlock"><Setter Property="FontFamily" Value="Segoe UI Variable Display"/><Setter Property="FontSize" Value="20"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <Style x:Key="SectionTitleText" TargetType="TextBlock"><Setter Property="FontSize" Value="18"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <Style x:Key="CardTitleText" TargetType="TextBlock"><Setter Property="FontSize" Value="15"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <Style x:Key="BodyText" TargetType="TextBlock"><Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="Normal"/><Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <Style x:Key="CaptionText" TargetType="TextBlock"><Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="Normal"/><Setter Property="Foreground" Value="{DynamicResource SecondaryText}"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <Style x:Key="MetricText" TargetType="TextBlock"><Setter Property="FontFamily" Value="Segoe UI Variable Display"/><Setter Property="FontSize" Value="26"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <Style x:Key="EyebrowText" TargetType="TextBlock"><Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{DynamicResource SecondaryText}"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <Style x:Key="FieldLabelText" TargetType="TextBlock"><Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/><Setter Property="Margin" Value="0,0,0,4"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
</ResourceDictionary>
