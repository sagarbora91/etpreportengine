<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="DisplayText" TargetType="TextBlock"><Setter Property="FontFamily" Value="Segoe UI Variable Display"/><Setter Property="FontSize" Value="32"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{StaticResource PrimaryText}"/></Style>
    <Style x:Key="PageTitleText" TargetType="TextBlock"><Setter Property="FontFamily" Value="Segoe UI Variable Display"/><Setter Property="FontSize" Value="25"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{StaticResource PrimaryText}"/></Style>
    <Style x:Key="SectionTitleText" TargetType="TextBlock"><Setter Property="FontSize" Value="18"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{StaticResource PrimaryText}"/></Style>
    <Style x:Key="CardTitleText" TargetType="TextBlock"><Setter Property="FontSize" Value="15"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{StaticResource PrimaryText}"/></Style>
    <Style x:Key="BodyText" TargetType="TextBlock"><Setter Property="FontSize" Value="13"/><Setter Property="Foreground" Value="{StaticResource PrimaryText}"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <Style x:Key="CaptionText" TargetType="TextBlock"><Setter Property="FontSize" Value="11"/><Setter Property="Foreground" Value="{StaticResource SecondaryText}"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <Style x:Key="MetricText" TargetType="TextBlock"><Setter Property="FontFamily" Value="Segoe UI Variable Display"/><Setter Property="FontSize" Value="26"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{StaticResource PrimaryText}"/></Style>
</ResourceDictionary>
