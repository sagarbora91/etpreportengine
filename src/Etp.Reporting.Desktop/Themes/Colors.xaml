<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="AppBackgroundColor">#F3F6FB</Color>
    <Color x:Key="SurfaceColor">#FFFFFF</Color>
    <Color x:Key="SurfaceSecondaryColor">#F7F9FC</Color>
    <Color x:Key="PrimaryTextColor">#152038</Color>
    <Color x:Key="SecondaryTextColor">#6B778C</Color>
    <Color x:Key="DividerColor">#E3E8F0</Color>
    <Color x:Key="AccentColor">#246BFE</Color>
    <Color x:Key="AccentDarkColor">#1553C8</Color>
    <Color x:Key="SuccessColor">#0B8D62</Color>
    <Color x:Key="WarningColor">#BB6B00</Color>
    <Color x:Key="CriticalColor">#C63B42</Color>
    <Color x:Key="InformationColor">#7757D6</Color>
    <Color x:Key="NavigationBackgroundColor">#0C1628</Color>
    <Color x:Key="NavigationSelectedColor">#16243D</Color>
    <SolidColorBrush x:Key="AppBackground" Color="{StaticResource AppBackgroundColor}"/>
    <SolidColorBrush x:Key="Surface" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="SurfaceSecondary" Color="{StaticResource SurfaceSecondaryColor}"/>
    <SolidColorBrush x:Key="PrimaryText" Color="{StaticResource PrimaryTextColor}"/>
    <SolidColorBrush x:Key="SecondaryText" Color="{StaticResource SecondaryTextColor}"/>
    <SolidColorBrush x:Key="Divider" Color="{StaticResource DividerColor}"/>
    <SolidColorBrush x:Key="Accent" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentDark" Color="{StaticResource AccentDarkColor}"/>
    <SolidColorBrush x:Key="Success" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="Warning" Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="Critical" Color="{StaticResource CriticalColor}"/>
    <SolidColorBrush x:Key="Information" Color="{StaticResource InformationColor}"/>
    <SolidColorBrush x:Key="NavigationBackground" Color="{StaticResource NavigationBackgroundColor}"/>
    <SolidColorBrush x:Key="NavigationSelected" Color="{StaticResource NavigationSelectedColor}"/>
</ResourceDictionary>
