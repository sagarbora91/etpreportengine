<UserControl x:Class="Etp.Reporting.Desktop.Modules.Accounting.AccountingWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             automation:AutomationProperties.Name="Accounting preparation workspace">
    <StackPanel>
        <TextBlock Text="Accounting Preparation" FontSize="18" FontWeight="SemiBold"/>
        <TextBlock Text="Prepare balanced, approval-controlled entries from a final immutable report generation. Canonical ETP facts are never edited."
                   Foreground="#5D6873" Margin="0,4,0,10" TextWrapping="Wrap"/>
        <WrapPanel>
            <TextBox x:Name="AccountingStoreInput" Width="110" Padding="6" Text="WLMHW"
                     automation:AutomationProperties.Name="Accounting store"/>
            <DatePicker x:Name="AccountingDateInput" Width="145" Margin="8,0,0,0"
                        automation:AutomationProperties.Name="Accounting business date"/>
            <Button Content="Preview batch" Click="PreviewAccountingBatch_Click" Padding="14,7" Margin="8,0,0,0"/>
            <Button Content="Save for review" Click="SaveAccountingBatch_Click" Padding="14,7" Margin="8,0,0,0"/>
            <Button Content="Approve selected" Click="ApproveAccountingBatch_Click" Padding="14,7" Margin="8,0,0,0"/>
            <Button Content="Export Tally XML…" Click="ExportTallyXml_Click" Padding="14,7" Margin="8,0,0,0"/>
        </WrapPanel>
        <TextBlock x:Name="AccountingStatus" Margin="0,10,0,0" TextWrapping="Wrap"
                   automation:AutomationProperties.Name="Accounting status"
                   automation:AutomationProperties.LiveSetting="Polite"/>
        <DataGrid x:Name="AccountingEntryGrid" AutoGenerateColumns="True" IsReadOnly="True"
                  MaxHeight="250" Margin="0,8,0,0"
                  automation:AutomationProperties.Name="Accounting batch preview"/>
        <TextBlock Text="Accounting batch history" FontWeight="SemiBold" Margin="0,14,0,6"/>
        <DataGrid x:Name="AccountingBatchGrid" AutoGenerateColumns="True" IsReadOnly="True"
                  SelectionMode="Single" MaxHeight="220"
                  automation:AutomationProperties.Name="Accounting batch history"/>
        <TextBlock Text="Owner-approved ledger mapping" FontWeight="SemiBold" Margin="0,14,0,6"/>
        <WrapPanel>
            <ComboBox x:Name="AccountingEventInput" Width="150" SelectedIndex="0"
                      automation:AutomationProperties.Name="Accounting business event">
                <ComboBoxItem Content="NET_SALES"/><ComboBoxItem Content="TENDER_TOTAL"/>
                <ComboBoxItem Content="SERVICE_SALES"/>
            </ComboBox>
            <TextBox x:Name="DebitLedgerInput" Width="170" Padding="6" Margin="8,0,0,0" ToolTip="Debit ledger"
                     automation:AutomationProperties.Name="Debit ledger"/>
            <TextBox x:Name="CreditLedgerInput" Width="170" Padding="6" Margin="8,0,0,0" ToolTip="Credit ledger"
                     automation:AutomationProperties.Name="Credit ledger"/>
            <TextBox x:Name="AccountingNarrationInput" Width="220" Padding="6" Margin="8,0,0,0"
                     Text="ETP {description} - {reference}" ToolTip="Narration template"
                     automation:AutomationProperties.Name="Accounting narration template"/>
            <TextBox x:Name="AccountingMappingReasonInput" Width="210" Padding="6" Margin="8,0,0,0"
                     ToolTip="Owner approval reason" automation:AutomationProperties.Name="Accounting approval reason"/>
            <Button Content="Approve mapping" Click="ApproveAccountingMapping_Click" Padding="14,7" Margin="8,0,0,0"/>
        </WrapPanel>
    </StackPanel>
</UserControl>
