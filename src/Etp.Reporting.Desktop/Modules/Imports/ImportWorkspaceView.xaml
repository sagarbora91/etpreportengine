<UserControl x:Class="Etp.Reporting.Desktop.Modules.Imports.ImportWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             automation:AutomationProperties.Name="ETP import workspace">
    <StackPanel>
        <TextBlock Text="ETP import source" FontWeight="SemiBold"/>
        <WrapPanel Margin="0,8,0,10">
            <TextBlock Text="Business date" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <DatePicker x:Name="ImportBusinessDateInput" Width="145" automation:AutomationProperties.Name="Import business date"/>
            <TextBlock Text="Store" VerticalAlignment="Center" Margin="14,0,6,0"/>
            <ComboBox x:Name="ImportStoreInput" Width="150" SelectedIndex="0" automation:AutomationProperties.Name="Import store">
                <ComboBoxItem Content="WLMHW"/>
                <ComboBoxItem Content="HEMW"/>
            </ComboBox>
        </WrapPanel>
        <WrapPanel Margin="0,0,0,10">
            <CheckBox x:Name="RestatementModeInput" Content="Controlled restatement of the current source" VerticalAlignment="Center" automation:AutomationProperties.Name="Controlled import restatement"/>
            <TextBox x:Name="RestatementReasonInput" Width="360" Padding="6" Margin="10,0,0,0" ToolTip="Required reason; the finalised day must be reopened first" automation:AutomationProperties.Name="Import restatement reason"/>
        </WrapPanel>
        <DockPanel Margin="0,8,0,12">
            <WrapPanel DockPanel.Dock="Right">
                <Button Content="Browse workbook/ZIP…" Click="BrowseWorkbook_Click" Padding="14,7" automation:AutomationProperties.Name="Browse workbook or ZIP"/>
                <Button Content="Browse folder…" Click="BrowseImportFolder_Click" Padding="14,7" Margin="8,0,0,0" automation:AutomationProperties.Name="Browse import folder"/>
            </WrapPanel>
            <TextBox x:Name="WorkbookPathInput" IsReadOnly="True" Padding="8" Margin="0,0,10,0" automation:AutomationProperties.Name="Selected import source"/>
        </DockPanel>
        <WrapPanel>
            <Button x:Name="ValidateButton" Content="Validate workbook" Click="ValidateWorkbook_Click" Padding="18,9" automation:AutomationProperties.Name="Validate workbook"/>
            <Button x:Name="PersistButton" Content="Import validated rows" Click="PersistWorkbook_Click" Padding="18,9" Margin="10,0,0,0" IsEnabled="False" automation:AutomationProperties.Name="Import validated rows"/>
            <Button x:Name="StartBatchButton" Content="Import batch" Click="StartBatchImport_Click" Padding="18,9" Margin="10,0,0,0" automation:AutomationProperties.Name="Import batch"/>
            <Button x:Name="CancelBatchButton" Content="Cancel" Click="CancelBatchImport_Click" Padding="18,9" Margin="10,0,0,0" IsEnabled="False" automation:AutomationProperties.Name="Cancel import batch"/>
            <Button x:Name="RetryBatchButton" Content="Retry failed" Click="RetryBatchImport_Click" Padding="18,9" Margin="10,0,0,0" IsEnabled="False" automation:AutomationProperties.Name="Retry failed imports"/>
        </WrapPanel>
        <ProgressBar x:Name="ImportProgressBar" Height="10" Margin="0,12,0,0" Minimum="0" Maximum="1" automation:AutomationProperties.Name="Import progress"/>
        <TextBlock x:Name="ValidationResult" Margin="0,12,0,0" TextWrapping="Wrap" automation:AutomationProperties.Name="Import validation status" automation:AutomationProperties.LiveSetting="Polite"/>
        <DataGrid x:Name="DiagnosticsGrid" Margin="0,12,0,0" AutoGenerateColumns="True" IsReadOnly="True" MaxHeight="180" automation:AutomationProperties.Name="Import diagnostics"/>
        <DataGrid x:Name="BatchResultsGrid" Margin="0,12,0,0" AutoGenerateColumns="True" IsReadOnly="True" MaxHeight="220" automation:AutomationProperties.Name="Batch import results"/>
    </StackPanel>
</UserControl>
