<UserControl x:Class="Etp.Reporting.Desktop.Modules.Imports.ImportWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             automation:AutomationProperties.Name="ETP folder import workspace">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="4">
            <WrapPanel>
                <Button x:Name="ImportFolderButton" Content="Import today's folder" Click="ImportFolder_Click" Style="{DynamicResource PrimaryButton}" MinHeight="44" Padding="16,8" Margin="0,0,8,8" automation:AutomationProperties.Name="Import today's folder"/>
                <Button Content="Choose workbook or ZIP" Click="BrowseWorkbook_Click" MinHeight="44" Padding="12,8" Margin="0,0,8,8" automation:AutomationProperties.Name="Choose workbook or ZIP"/>
                <Button x:Name="StartBatchButton" Content="Import selected source" Click="StartBatchImport_Click" MinHeight="44" Padding="12,8" Margin="0,0,8,8" automation:AutomationProperties.Name="Import selected source"/>
                <Button x:Name="CancelBatchButton" Content="Cancel" Click="CancelBatchImport_Click" MinHeight="44" Padding="12,8" IsEnabled="False" Margin="0,0,8,8" automation:AutomationProperties.Name="Cancel folder import"/>
            </WrapPanel>
            <TextBlock Text="Choose either store folder, or a parent containing both. Store and dates are detected from each file." TextWrapping="Wrap" Margin="0,0,0,8"/>
            <TextBlock x:Name="DetectedScopeText" Text="Detected store and date range will appear here." TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,8" automation:AutomationProperties.Name="Detected import scope"/>
            <ProgressBar x:Name="ImportProgressBar" Height="10" Minimum="0" Maximum="1" Margin="0,4,0,8" automation:AutomationProperties.Name="Folder import progress"/>
            <TextBlock x:Name="ValidationResult" Text="Ready to import a folder." TextWrapping="Wrap" Margin="0,0,0,8" automation:AutomationProperties.Name="Folder import status" automation:AutomationProperties.LiveSetting="Polite"/>
            <Expander x:Name="ImportOptionsExpander" Header="Source and restatement options" Margin="0,0,0,8" automation:AutomationProperties.Name="Source and restatement options">
                <StackPanel>
            <TextBox x:Name="WorkbookPathInput" IsReadOnly="True" Padding="8" Margin="0,0,0,8" automation:AutomationProperties.Name="Selected import source"/>
            <CheckBox x:Name="RestatementModeInput" Content="Override for restatement (Owner)" Checked="RestatementMode_Changed" Unchecked="RestatementMode_Changed" MinHeight="32" automation:AutomationProperties.Name="Override for restatement"/>
            <TextBlock Text="Overrides can fill a missing store or date. Values already detected in the file must match; a corrected file is required to change them." TextWrapping="Wrap" Margin="0,0,0,8"/>
            <WrapPanel x:Name="OverridePanel" Visibility="Collapsed" Margin="0,0,0,8">
                <TextBlock Text="Store override" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox x:Name="ImportStoreInput" Width="120" SelectedIndex="-1" IsEnabled="False" automation:AutomationProperties.Name="Restatement store override"><ComboBoxItem Content="WLMHW"/><ComboBoxItem Content="HEMW"/></ComboBox>
                <TextBlock Text="Date override" VerticalAlignment="Center" Margin="10,0,6,0"/>
                <DatePicker x:Name="ImportBusinessDateInput" Width="145" IsEnabled="False" automation:AutomationProperties.Name="Restatement date override"/>
                <TextBox x:Name="RestatementReasonInput" Width="260" Margin="8,0,0,0" Padding="6" automation:AutomationProperties.Name="Required restatement reason"/>
            </WrapPanel>
                </StackPanel>
            </Expander>
            <DataGrid x:Name="BatchResultsGrid" AutoGenerateColumns="False" IsReadOnly="True" MinHeight="160" MaxHeight="300" RowHeight="36" SelectionMode="Single" SelectionChanged="Result_SelectionChanged" HorizontalScrollBarVisibility="Auto" automation:AutomationProperties.Name="Per-file import results">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="File" Binding="{Binding FileName}" Width="250"/>
                    <DataGridTextColumn Header="Result" Binding="{Binding Status}" Width="130"/>
                    <DataGridTextColumn Header="Rows" Binding="{Binding RowsProcessed, StringFormat=N0}" Width="70"/>
                    <DataGridTextColumn Header="New" Binding="{Binding NewRows, StringFormat=N0}" Width="70"/>
                    <DataGridTextColumn Header="Present" Binding="{Binding AlreadyPresentRows, StringFormat=N0}" Width="75"/>
                    <DataGridTextColumn Header="Conflicts" Binding="{Binding ConflictRows, StringFormat=N0}" Width="75"/>
                    <DataGridTextColumn Header="Report" Binding="{Binding ReportCode}" Width="70"/>
                    <DataGridTextColumn Header="Store" Binding="{Binding StoreCode}" Width="75"/>
                    <DataGridTextColumn Header="Date range" Binding="{Binding Period}" Width="215"/>
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock x:Name="FileDetailText" Text="Select a file to see its results and diagnostics." TextWrapping="Wrap" Margin="0,8,0,8" automation:AutomationProperties.Name="Selected file result details"/>
            <DataGrid x:Name="DiagnosticsGrid" Visibility="Collapsed" AutoGenerateColumns="False" IsReadOnly="True" MinHeight="80" MaxHeight="180" HorizontalScrollBarVisibility="Auto" automation:AutomationProperties.Name="Selected file diagnostics">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Issue" Binding="{Binding Code}" Width="210"/>
                    <DataGridTextColumn Header="Column" Binding="{Binding SourceColumn}" Width="160"/>
                    <DataGridTextColumn Header="Details" Binding="{Binding Message}" Width="*" MinWidth="300">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Padding" Value="4"/></Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
