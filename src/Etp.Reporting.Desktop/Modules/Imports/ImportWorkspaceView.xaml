<UserControl x:Class="Etp.Reporting.Desktop.Modules.Imports.ImportWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             automation:AutomationProperties.Name="ETP folder import workspace">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="4">
            <WrapPanel>
                <Button x:Name="ImportFolderButton" Content="Import a folder" Click="ImportFolder_Click" Style="{DynamicResource PrimaryButton}" Margin="0,0,8,8" automation:AutomationProperties.Name="Import a folder"/>
                <Button Content="Choose workbook or ZIP" Click="BrowseWorkbook_Click" Margin="0,0,8,8" automation:AutomationProperties.Name="Choose workbook or ZIP"/>
                <Button x:Name="StartBatchButton" Content="Import selected source" Click="StartBatchImport_Click" Margin="0,0,8,8" automation:AutomationProperties.Name="Import selected source"/>
                <Button x:Name="GetBlankSheetButton" Content="Get blank daily sheet" Click="GetBlankSheet_Click" Margin="0,0,8,8" automation:AutomationProperties.Name="Get blank daily sheet"/>
                <Button x:Name="OpenBlankSheetFolderButton" Content="Open folder" Click="OpenBlankSheetFolder_Click" Visibility="Collapsed" Margin="0,0,8,8" automation:AutomationProperties.Name="Open the folder the blank daily sheet was saved in"/>
                <Button x:Name="CancelBatchButton" Content="Cancel" Click="CancelBatchImport_Click" IsEnabled="False" Margin="0,0,8,8" automation:AutomationProperties.Name="Cancel folder import"/>
            </WrapPanel>
            <!-- DS-12: before any import there is one EmptyState card, not six pieces of empty chrome. The progress bar,
                 detected scope, grid and detail line appear in ResultsPanel when an import starts. -->
            <Border x:Name="ImportEmptyState" Style="{DynamicResource InsetCard}" Margin="0,0,0,8" automation:AutomationProperties.Name="No import yet">
                <StackPanel>
                    <TextBlock Text="No import has been run in this window yet." Style="{DynamicResource CardTitleText}"/>
                    <TextBlock Text="Choose the folder that holds the exports, or a ZIP. ETP finds the shop and the date in each file. Imports that ran on their own are listed in History." Style="{DynamicResource BodyText}" Margin="0,4,0,8"/>
                    <Button x:Name="EmptyStateHistoryButton" Content="Show Import History" Click="ShowImportHistory_Click" HorizontalAlignment="Left" Visibility="Collapsed"
                            automation:AutomationProperties.Name="Show Import History"/>
                </StackPanel>
            </Border>
            <TextBlock x:Name="ValidationResult" Style="{DynamicResource BodyText}" Margin="0,0,0,8" automation:AutomationProperties.Name="Folder import status" automation:AutomationProperties.LiveSetting="Polite"/>
            <WrapPanel x:Name="HandOffPanel" Visibility="Collapsed" Margin="0,0,0,8">
                <Button x:Name="ShowDsrButton" Content="Show the Daily Sales Report" Click="ShowDailySalesReport_Click" Margin="0,0,8,0"
                        automation:AutomationProperties.Name="Show the Daily Sales Report for the imported date"/>
                <Button x:Name="ShowHistoryButton" Content="Show Import History" Click="ShowImportHistory_Click"
                        automation:AutomationProperties.Name="Show Import History"/>
            </WrapPanel>
            <Expander x:Name="ImportOptionsExpander" Header="Source and restatement options" Margin="0,0,0,8" automation:AutomationProperties.Name="Source and restatement options">
                <StackPanel>
            <TextBox x:Name="WorkbookPathInput" IsReadOnly="True" Margin="0,0,0,8" automation:AutomationProperties.Name="Selected import source"/>
            <CheckBox x:Name="RestatementModeInput" Content="Request restatement approval" Checked="RestatementMode_Changed" Unchecked="RestatementMode_Changed" MinHeight="{DynamicResource ActiveTargetHeight}" automation:AutomationProperties.Name="Request restatement approval"/>
            <TextBlock Text="Overrides can fill a missing store or date. Values already detected in the file must match; a corrected file is required to change them." TextWrapping="Wrap" Margin="0,0,0,8"/>
            <WrapPanel x:Name="OverridePanel" Visibility="Collapsed" Margin="0,0,0,8">
                <TextBlock Text="Store override" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox x:Name="ImportStoreInput" Width="120" SelectedIndex="-1" IsEnabled="False" automation:AutomationProperties.Name="Restatement store override"></ComboBox>
                <TextBlock Text="Date override" VerticalAlignment="Center" Margin="10,0,6,0"/>
                <DatePicker x:Name="ImportBusinessDateInput" Width="145" IsEnabled="False" automation:AutomationProperties.Name="Restatement date override"/>
                <TextBox x:Name="RestatementReasonInput" Width="260" Margin="8,0,0,0" Padding="6" automation:AutomationProperties.Name="Required restatement reason"/>
            </WrapPanel>
                </StackPanel>
            </Expander>
            <StackPanel x:Name="ResultsPanel" Visibility="Collapsed">
            <TextBlock x:Name="DetectedScopeText" Style="{DynamicResource CaptionText}" Margin="0,0,0,8" automation:AutomationProperties.Name="Detected import scope"/>
            <ProgressBar x:Name="ImportProgressBar" Height="10" Minimum="0" Maximum="1" Margin="0,4,0,8" automation:AutomationProperties.Name="Folder import progress"/>
            <DataGrid x:Name="BatchResultsGrid" AutoGenerateColumns="False" IsReadOnly="True" MinHeight="160" RowHeight="{DynamicResource ActiveGridRowHeight}" SelectionMode="Single" SelectionChanged="Result_SelectionChanged" HorizontalScrollBarVisibility="Auto" automation:AutomationProperties.Name="Per-file import results">
            </DataGrid>
            <TextBlock x:Name="FileDetailText" Text="Select a file to see its results and diagnostics." Style="{DynamicResource CaptionText}" Margin="0,8,0,8" automation:AutomationProperties.Name="Selected file result details"/>
            <DataGrid x:Name="DiagnosticsGrid" Visibility="Collapsed" AutoGenerateColumns="False" IsReadOnly="True" MinHeight="80" MaxHeight="180" HorizontalScrollBarVisibility="Auto" automation:AutomationProperties.Name="Selected file diagnostics">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Issue" Binding="{Binding Code}" Width="210"/>
                    <DataGridTextColumn Header="Column" Binding="{Binding SourceColumn}" Width="160"/>
                    <DataGridTextColumn Header="Details" Binding="{Binding Message}" Width="*" MinWidth="300">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Padding" Value="4"/></Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
