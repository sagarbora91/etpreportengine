<UserControl x:Class="Etp.Reporting.Desktop.Modules.Settings.SettingsWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             automation:AutomationProperties.Name="Settings workspace">
    <Border Style="{DynamicResource Card}">
        <StackPanel>
            <TextBlock Text="SQL Server connection string" FontWeight="SemiBold"/>
            <TextBox x:Name="ConnectionStringInput" Margin="0,8,0,12" Padding="8"
                     automation:AutomationProperties.Name="Windows-integrated SQL Server connection string"/>
            <StackPanel Orientation="Horizontal">
                <Button x:Name="TestConnectionButton" Content="Test connection" Click="TestConnection_Click" Style="{DynamicResource PrimaryButton}" Padding="18,9"
                        automation:AutomationProperties.Name="Test Windows-integrated database connection"/>
                <Button x:Name="BootstrapDatabaseButton" Content="Create/update database" Click="BootstrapDatabase_Click"
                        Padding="18,9" Margin="10,0,0,0"
                        automation:AutomationProperties.Name="Create or update the ETP database"/>
            </StackPanel>
            <TextBlock x:Name="ConnectionResult" Margin="0,12,0,0" TextWrapping="Wrap"
                       automation:AutomationProperties.Name="Settings operation status"
                       automation:AutomationProperties.LiveSetting="Polite"/>



            <Separator Margin="0,16,0,12"/>
            <StackPanel x:Name="ProductSettingsPanel">
                <TextBlock Text="Product integrations" FontWeight="SemiBold"/>
                <TextBlock Text="Choose local folders for scanned documents and shared reports."
                           Foreground="#5D6873" Margin="0,4,0,8" TextWrapping="Wrap"/>
                <TextBlock Text="Document repository"/>
                <TextBox x:Name="DocumentRepositoryInput" Padding="6" Margin="0,3,0,6"
                         automation:AutomationProperties.Name="Document repository path"/>
                <TextBlock Text="Share folder"/>
                <TextBox x:Name="ShareFolderInput" Padding="6" Margin="0,3,0,6"
                         automation:AutomationProperties.Name="Report share folder path"/>
                <WrapPanel>
                    <TextBox x:Name="SmtpHostInput" Width="190" Padding="6" ToolTip="Optional SMTP host metadata"
                             automation:AutomationProperties.Name="Optional SMTP host metadata"/>
                    <TextBox x:Name="SmtpPortInput" Width="80" Padding="6" Margin="8,0,0,0" ToolTip="SMTP port"
                             automation:AutomationProperties.Name="SMTP port"/>
                    <TextBox x:Name="SmtpFromInput" Width="230" Padding="6" Margin="8,0,0,0" ToolTip="From address"
                             automation:AutomationProperties.Name="SMTP from address"/>
                    <TextBox x:Name="MaximumAttachmentInput" Width="100" Padding="6" Margin="8,0,0,0" ToolTip="Maximum attachment MB"
                             automation:AutomationProperties.Name="Maximum attachment size in megabytes"/>
                    <TextBox x:Name="ProductSettingsReasonInput" Width="230" Padding="6" Margin="8,0,0,0" ToolTip="Owner change reason"
                             automation:AutomationProperties.Name="Owner product-settings change reason"/>
                    <Button x:Name="SaveIntegrationsButton" Content="Save integrations" Click="SaveProductSettings_Click" Style="{DynamicResource PrimaryButton}"
                            Padding="14,7" Margin="8,0,0,0"
                            automation:AutomationProperties.Name="Save product integrations"/>
                </WrapPanel>
            </StackPanel>
            <StackPanel x:Name="DataTruthMastersHost"/>
            <Expander Header="Encrypted backup recovery keys" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="Owner setup: choose two recovery folders on USB drives or cloud storage outside this PC. SQL Server must have permission to write there. Keep the password separately. Native encryption requires a supported SQL edition." TextWrapping="Wrap" Margin="0,6"/>
                    <DockPanel Margin="0,4">
                        <Button Content="Choose first location" DockPanel.Dock="Right" Click="ChooseRecoveryLocation_Click" Tag="first" MinHeight="44"/>
                        <TextBox x:Name="FirstRecoveryLocation" IsReadOnly="True" MinHeight="44" automation:AutomationProperties.Name="First recovery key location"/>
                    </DockPanel>
                    <DockPanel Margin="0,4">
                        <Button Content="Choose second location" DockPanel.Dock="Right" Click="ChooseRecoveryLocation_Click" Tag="second" MinHeight="44"/>
                        <TextBox x:Name="SecondRecoveryLocation" IsReadOnly="True" MinHeight="44" automation:AutomationProperties.Name="Second recovery key location"/>
                    </DockPanel>
                    <TextBlock Text="Recovery password (at least sixteen characters)"/>
                    <PasswordBox x:Name="RecoveryPassword" MinHeight="44" automation:AutomationProperties.Name="Recovery key password"/>
                    <CheckBox x:Name="RecoveryLocationsConfirmed" Content="Both locations provide a copy outside this PC" MinHeight="44"/>
                    <Button x:Name="ExportRecoveryKeysButton" Content="Create and export recovery keys" Click="ExportRecoveryKeys_Click" MinHeight="44" IsEnabled="False"/>
                </StackPanel>
            </Expander>
        </StackPanel>
    </Border>
</UserControl>
