<UserControl x:Class="Etp.Reporting.Desktop.Modules.Settings.SettingsWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             automation:AutomationProperties.Name="Settings workspace">
    <Border Style="{DynamicResource Card}">
        <StackPanel>
            <TextBlock Text="SQL Server connection string" FontWeight="SemiBold"/>
            <TextBox x:Name="ConnectionStringInput" Margin="0,8,0,12" Padding="8"
                     automation:AutomationProperties.Name="Windows-integrated SQL Server connection string"/>
            <StackPanel Orientation="Horizontal">
                <Button x:Name="TestConnectionButton" Content="Test connection" Click="TestConnection_Click" Padding="18,9"
                        automation:AutomationProperties.Name="Test Windows-integrated database connection"/>
                <Button x:Name="BootstrapDatabaseButton" Content="Create/update database" Click="BootstrapDatabase_Click"
                        Padding="18,9" Margin="10,0,0,0"
                        automation:AutomationProperties.Name="Create or update the ETP database"/>
            </StackPanel>
            <TextBlock x:Name="ConnectionResult" Margin="0,12,0,0" TextWrapping="Wrap"
                       automation:AutomationProperties.Name="Settings operation status"
                       automation:AutomationProperties.LiveSetting="Polite"/>

            <Separator Margin="0,16,0,12"/>
            <StackPanel x:Name="ProductSettingsPanel">
                <TextBlock Text="Product integrations" FontWeight="SemiBold"/>
                <TextBlock Text="Local paths contain no passwords. OCR is optional and reporting remains available when it is not configured."
                           Foreground="#5D6873" Margin="0,4,0,8" TextWrapping="Wrap"/>
                <TextBlock Text="Document repository"/>
                <TextBox x:Name="DocumentRepositoryInput" Padding="6" Margin="0,3,0,6"
                         automation:AutomationProperties.Name="Document repository path"/>
                <TextBlock Text="Share folder"/>
                <TextBox x:Name="ShareFolderInput" Padding="6" Margin="0,3,0,6"
                         automation:AutomationProperties.Name="Report share folder path"/>
                <TextBlock Text="PaddleOCR helper (optional)"/>
                <TextBox x:Name="OcrHelperInput" Padding="6" Margin="0,3,0,6"
                         automation:AutomationProperties.Name="Optional PaddleOCR helper path"/>
                <TextBlock Text="PaddleOCR model folder (optional)"/>
                <TextBox x:Name="OcrModelInput" Padding="6" Margin="0,3,0,6"
                         automation:AutomationProperties.Name="Optional PaddleOCR model folder"/>
                <WrapPanel>
                    <TextBox x:Name="SmtpHostInput" Width="190" Padding="6" ToolTip="Optional SMTP host metadata"
                             automation:AutomationProperties.Name="Optional SMTP host metadata"/>
                    <TextBox x:Name="SmtpPortInput" Width="80" Padding="6" Margin="8,0,0,0" ToolTip="SMTP port"
                             automation:AutomationProperties.Name="SMTP port"/>
                    <TextBox x:Name="SmtpFromInput" Width="230" Padding="6" Margin="8,0,0,0" ToolTip="From address"
                             automation:AutomationProperties.Name="SMTP from address"/>
                    <TextBox x:Name="MaximumAttachmentInput" Width="100" Padding="6" Margin="8,0,0,0" ToolTip="Maximum attachment MB"
                             automation:AutomationProperties.Name="Maximum attachment size in megabytes"/>
                    <TextBox x:Name="ProductSettingsReasonInput" Width="230" Padding="6" Margin="8,0,0,0" ToolTip="Owner change reason"
                             automation:AutomationProperties.Name="Owner product-settings change reason"/>
                    <Button x:Name="SaveIntegrationsButton" Content="Save integrations" Click="SaveProductSettings_Click"
                            Padding="14,7" Margin="8,0,0,0"
                            automation:AutomationProperties.Name="Save product integrations"/>
                </WrapPanel>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
