<UserControl x:Class="Etp.Reporting.Desktop.Modules.OperationsAdministration.OperationsWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore">
    <StackPanel>
        <DockPanel><TextBlock Text="Management analytics and data quality" FontSize="18" FontWeight="SemiBold"/><Button DockPanel.Dock="Right" Content="Refresh operations" Click="RefreshOperations_Click" Padding="14,6" automation:AutomationProperties.Name="Refresh operations center"/></DockPanel>
        <WrapPanel Margin="0,10,0,8"><TextBlock Text="From" VerticalAlignment="Center"/><DatePicker x:Name="OperationsFromInput" Width="140" Margin="6,0,10,0" automation:AutomationProperties.Name="Management trend start date"/><TextBlock Text="To" VerticalAlignment="Center"/><DatePicker x:Name="OperationsToInput" Width="140" Margin="6,0,0,0" automation:AutomationProperties.Name="Management trend end date"/></WrapPanel>
        <TextBlock x:Name="OperationsStatus" Text="Refresh to load trends, data-quality findings and automation status." TextWrapping="Wrap" automation:AutomationProperties.LiveSetting="Polite"/>
        <TextBlock Text="Sales and control trend" FontWeight="SemiBold" Margin="0,14,0,6"/><DataGrid x:Name="ManagementTrendGrid" AutoGenerateColumns="True" IsReadOnly="True" MaxHeight="220" automation:AutomationProperties.Name="Management sales and control trend"/><StackPanel x:Name="ManagementTrendChartPanel" Margin="0,8,0,0" automation:AutomationProperties.Name="Management sales trend chart"/>
        <TextBlock Text="Data-quality control centre" FontWeight="SemiBold" Margin="0,14,0,6"/><DataGrid x:Name="DataQualityGrid" AutoGenerateColumns="True" IsReadOnly="True" SelectionMode="Single" MaxHeight="190" automation:AutomationProperties.Name="Data quality findings"/><WrapPanel Margin="0,6,0,0"><TextBox x:Name="IssueWorkflowReasonInput" Width="330" Padding="6" ToolTip="Required issue action reason" automation:AutomationProperties.Name="Data quality issue reason"/><Button Content="Acknowledge" Tag="ACKNOWLEDGED" Click="UpdateIssueWorkflow_Click" Padding="12,7" Margin="8,0,0,0"/><Button Content="Resolve" Tag="RESOLVED" Click="UpdateIssueWorkflow_Click" Padding="12,7" Margin="8,0,0,0"/><Button Content="Waive" Tag="WAIVED" Click="UpdateIssueWorkflow_Click" Padding="12,7" Margin="8,0,0,0"/></WrapPanel>
        <Separator Margin="0,16,0,12"/>
        <TextBlock Text="Automatic ETP watch folder" FontWeight="SemiBold"/><TextBlock Text="Approved XLSX/ZIP files are imported once stable, duplicates are skipped, failures are quarantined, and completed sources are moved out of the inbound folder." Margin="0,5,0,8" Foreground="#5D6873" TextWrapping="Wrap"/>
        <TextBlock Text="Inbound"/><TextBox x:Name="WatchInboundInput" Padding="6" Margin="0,3,0,6" automation:AutomationProperties.Name="Automatic import inbound folder"/><TextBlock Text="Processed"/><TextBox x:Name="WatchProcessedInput" Padding="6" Margin="0,3,0,6" automation:AutomationProperties.Name="Automatic import processed folder"/><TextBlock Text="Failed quarantine"/><TextBox x:Name="WatchFailedInput" Padding="6" Margin="0,3,0,6" automation:AutomationProperties.Name="Automatic import failed folder"/><TextBlock Text="Generated report packs"/><TextBox x:Name="WatchReportOutputInput" Padding="6" Margin="0,3,0,6" automation:AutomationProperties.Name="Automatic report output folder"/>
        <WrapPanel><CheckBox x:Name="WatchEnabledInput" Content="Enable unattended processing" VerticalAlignment="Center" automation:AutomationProperties.Name="Enable unattended ETP processing"/><TextBox x:Name="WatchChangeReasonInput" Width="260" Padding="6" Margin="12,0,0,0" ToolTip="Owner reason required" automation:AutomationProperties.Name="Automation settings change reason"/><Button Content="Save automation settings" Click="SaveAutomationSettings_Click" Padding="14,7" Margin="8,0,0,0"/><Button Content="Run automation now" Click="RunAutomationNow_Click" Padding="14,7" Margin="8,0,0,0"/></WrapPanel>
        <TextBlock Text="Morning and evening schedules" FontWeight="SemiBold" Margin="0,14,0,6"/><DataGrid x:Name="ReportSchedulesGrid" AutoGenerateColumns="True" IsReadOnly="True" SelectionMode="Single" SelectionChanged="ReportSchedule_SelectionChanged" MaxHeight="140" automation:AutomationProperties.Name="Automatic report schedules"/><WrapPanel Margin="0,6,0,0"><TextBox x:Name="ScheduleTimeInput" Width="90" Padding="6" ToolTip="24-hour time, for example 08:00" automation:AutomationProperties.Name="Selected schedule time"/><CheckBox x:Name="ScheduleEnabledInput" Content="Enabled" Margin="10,5,0,0"/><CheckBox x:Name="ScheduleExcelInput" Content="Excel" IsChecked="True" Margin="10,5,0,0"/><CheckBox x:Name="SchedulePdfInput" Content="PDF" IsChecked="True" Margin="10,5,0,0"/><TextBox x:Name="ScheduleReasonInput" Width="230" Padding="6" Margin="10,0,0,0" ToolTip="Owner reason required" automation:AutomationProperties.Name="Schedule change reason"/><Button Content="Update selected schedule" Click="SaveSchedule_Click" Padding="14,7" Margin="8,0,0,0"/></WrapPanel>
        <TextBlock Text="Recent unattended activity" FontWeight="SemiBold" Margin="0,14,0,6"/><DataGrid x:Name="AutomationRunsGrid" AutoGenerateColumns="True" IsReadOnly="True" MaxHeight="190" automation:AutomationProperties.Name="Recent unattended operations"/>
        <Separator Margin="0,16,0,12"/><TextBlock Text="Backup, recovery and support" FontWeight="SemiBold"/><WrapPanel Margin="0,8,0,0"><Button Content="Run checksum backup now" Click="RunBackupNow_Click" Padding="14,7" automation:AutomationProperties.Name="Run database backup now"/><Button Content="Run isolated recovery drill" Click="RunRecoveryDrillNow_Click" Padding="14,7" Margin="8,0,0,0" automation:AutomationProperties.Name="Run isolated database recovery drill"/><Button Content="Create privacy-safe support package" Click="CreateSupportPackage_Click" Padding="14,7" Margin="8,0,0,0" automation:AutomationProperties.Name="Create privacy-safe support package"/></WrapPanel><TextBlock x:Name="MaintenanceStatus" Margin="0,8,0,0" TextWrapping="Wrap" automation:AutomationProperties.LiveSetting="Polite"/>
    </StackPanel>
</UserControl>
