<UserControl x:Class="Etp.Reporting.Desktop.Modules.OperationsAdministration.InvestigationApprovalsWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore">
    <StackPanel>
        <TextBlock Text="Global investigation" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Search invoices, products, source files, generated reports, documents and register entries from one place." Foreground="#5D6873" Margin="0,4,0,8" TextWrapping="Wrap"/>
        <WrapPanel><TextBox x:Name="GlobalSearchInput" Width="360" Padding="7" automation:AutomationProperties.Name="Global investigation search"/><Button Content="Search" Click="RunGlobalSearch_Click" Padding="16,8" Margin="8,0,0,0"/><Button Content="Refresh approvals" Click="RefreshApprovals_Click" Padding="16,8" Margin="8,0,0,0"/></WrapPanel>
        <TextBlock x:Name="InvestigationStatus" Margin="0,8,0,0" TextWrapping="Wrap" automation:AutomationProperties.LiveSetting="Polite"/><DataGrid x:Name="InvestigationGrid" AutoGenerateColumns="True" IsReadOnly="True" MaxHeight="240" Margin="0,8,0,0" automation:AutomationProperties.Name="Global investigation results"/>
        <TextBlock Text="Controlled adjustment request" FontWeight="SemiBold" Margin="0,14,0,6"/><WrapPanel><TextBox x:Name="AdjustmentStoreInput" Width="100" Padding="6" Text="WLMHW" ToolTip="Store" automation:AutomationProperties.Name="Adjustment store"/><DatePicker x:Name="AdjustmentDateInput" Width="140" Margin="8,0,0,0" automation:AutomationProperties.Name="Adjustment business date"/><TextBox x:Name="AdjustmentTypeInput" Width="150" Padding="6" Margin="8,0,0,0" ToolTip="Adjustment type" automation:AutomationProperties.Name="Adjustment type"/><TextBox x:Name="AdjustmentAmountInput" Width="120" Padding="6" Margin="8,0,0,0" ToolTip="Signed amount" automation:AutomationProperties.Name="Signed adjustment amount"/><TextBox x:Name="AdjustmentReasonInput" Width="300" Padding="6" Margin="8,0,0,0" ToolTip="Required reason" automation:AutomationProperties.Name="Adjustment reason"/><Button Content="Submit for approval" Click="SubmitAdjustment_Click" Padding="14,7" Margin="8,0,0,0"/></WrapPanel>
        <TextBlock Text="Approval Centre" FontWeight="SemiBold" Margin="0,16,0,6"/><DataGrid x:Name="ApprovalGrid" AutoGenerateColumns="True" IsReadOnly="True" SelectionMode="Single" MaxHeight="220" automation:AutomationProperties.Name="Pending approvals"/><WrapPanel Margin="0,8,0,0"><TextBox x:Name="ApprovalReasonInput" Width="360" Padding="6" ToolTip="Owner decision reason" automation:AutomationProperties.Name="Approval decision reason"/><Button Content="Approve selected" Click="ApproveSelected_Click" Padding="14,7" Margin="8,0,0,0"/><Button Content="Reject selected" Click="RejectSelected_Click" Padding="14,7" Margin="8,0,0,0"/></WrapPanel>
    </StackPanel>
</UserControl>
