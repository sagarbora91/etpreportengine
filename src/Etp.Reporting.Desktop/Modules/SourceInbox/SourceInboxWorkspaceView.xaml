<UserControl x:Class="Etp.Reporting.Desktop.Modules.SourceInbox.SourceInboxWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             automation:AutomationProperties.Name="Scanned documents workspace">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel>
        <DockPanel>
            <Button x:Name="RefreshButton" DockPanel.Dock="Right" Content="Refresh inbox" Click="Refresh_Click" Style="{DynamicResource PrimaryButton}"
                    Padding="14,7" Margin="8,0,0,0" VerticalAlignment="Top" automation:AutomationProperties.Name="Refresh Source Inbox"/>
            <StackPanel>
                <TextBlock Text="Source Inbox" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock Text="Attach a scanned document to a business day. Originals are stored with a SHA-256 hash and opened in your document viewer."
                           Foreground="#5D6873" TextWrapping="Wrap" Margin="0,4,0,0"/>
            </StackPanel>
        </DockPanel>
        <WrapPanel Margin="0,12,0,8">
            <ComboBox x:Name="StatusInput" Width="170" SelectedIndex="0" automation:AutomationProperties.Name="Source Inbox status filter">
                <ComboBoxItem Content="All"/><ComboBoxItem Content="Received"/>
                <ComboBoxItem Content="Imported"/><ComboBoxItem Content="Duplicate"/><ComboBoxItem Content="Conflict"/>
                <ComboBoxItem Content="Quarantined"/>
            </ComboBox>
            <Button x:Name="BrowseButton" Content="Add PDF or image…" Click="Browse_Click" Padding="14,7" Margin="8,0,0,0"
                    automation:AutomationProperties.Name="Add PDF or image to Source Inbox"/>
            <Button x:Name="OpenButton" Content="Verify/open selected" Click="Open_Click" Padding="14,7" Margin="8,0,0,0"
                    automation:AutomationProperties.Name="Verify and open selected source document"/>
            <TextBox x:Name="DocumentPathInput" Width="280" IsReadOnly="True" Padding="6" Margin="8,0,0,0"
                     automation:AutomationProperties.Name="Selected source document"/>
        </WrapPanel>
        <WrapPanel Margin="0,0,0,8">
            <StackPanel Margin="0,0,8,0">
                <TextBlock Text="Store code" Margin="0,0,0,4"/>
                <TextBox x:Name="DocumentStoreInput" Width="110" Padding="6" automation:AutomationProperties.Name="Document store"/>
            </StackPanel>
            <StackPanel Margin="0,0,8,0">
                <TextBlock Text="Business day" Margin="0,0,0,4"/>
                <DatePicker x:Name="DocumentDateInput" Width="145" automation:AutomationProperties.Name="Document business date"/>
            </StackPanel>
            <StackPanel Margin="0,0,8,0">
                <TextBlock Text="Document type" Margin="0,0,0,4"/>
            <ComboBox x:Name="DocumentTypeInput" Width="180" SelectedIndex="0" automation:AutomationProperties.Name="Document type">
                <ComboBoxItem Content="Inward Invoice"/><ComboBoxItem Content="Vendor Invoice"/><ComboBoxItem Content="Credit Note"/>
                <ComboBoxItem Content="Stock Transfer"/><ComboBoxItem Content="Other"/>
            </ComboBox>
            </StackPanel>
            <Button x:Name="IntakeButton" Content="Attach to day" Click="Intake_Click" Style="{DynamicResource PrimaryButton}" Padding="14,7" VerticalAlignment="Bottom"
                    automation:AutomationProperties.Name="Attach scanned document to business day"/>
        </WrapPanel>
        <TextBlock x:Name="StatusText" Text="Refresh to view received sources." TextWrapping="Wrap"
                   automation:AutomationProperties.LiveSetting="Polite"/>
        <DataGrid x:Name="DocumentsGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                  SelectionChanged="Documents_SelectionChanged" MaxHeight="260" Margin="0,8,0,0"
                  automation:AutomationProperties.Name="Source Inbox documents">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Business day" Binding="{Binding BusinessDate, StringFormat=dd MMM yyyy}" Width="130"/>
                <DataGridTextColumn Header="Store" Binding="{Binding StoreCode}" Width="80"/>
                <DataGridTextColumn Header="Document" Binding="{Binding OriginalFileName}" Width="280"/>
                <DataGridTextColumn Header="Type" Binding="{Binding SourceType}" Width="110"/>
                <DataGridTextColumn Header="Status" Binding="{Binding LifecycleStatus}" Width="120"/>
                <DataGridTextColumn Header="SHA-256" Binding="{Binding Sha256}" Width="440"/>
            </DataGrid.Columns>
        </DataGrid>
    </StackPanel>
    </ScrollViewer>
</UserControl>
