<UserControl x:Class="Etp.Reporting.Desktop.Modules.Reports.ReportsWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             xmlns:reports="clr-namespace:Etp.Reporting.Desktop.Modules.Reports"
             automation:AutomationProperties.Name="Reports workspace">
    <StackPanel>
        <TextBlock Text="Report range and filters" FontWeight="SemiBold"/>
        <WrapPanel Margin="0,8,0,6"><DatePicker x:Name="ReportFrom" Width="145" automation:AutomationProperties.Name="Report start date"/><TextBlock Text="to" Margin="8,5"/><DatePicker x:Name="ReportTo" Width="145" automation:AutomationProperties.Name="Report end date"/><ComboBox x:Name="SalesDimensionInput" Width="160" Margin="10,0,0,0" SelectedIndex="0" automation:AutomationProperties.Name="Sales dimension"><ComboBoxItem Content="Daily"/><ComboBoxItem Content="Store"/><ComboBoxItem Content="Brand"/><ComboBoxItem Content="BrandSegment"/><ComboBoxItem Content="Item"/><ComboBoxItem Content="Returns"/></ComboBox></WrapPanel>
        <WrapPanel Margin="0,0,0,8"><TextBox x:Name="StoreFilterInput" Width="120" Padding="6" Margin="0,0,8,0" ToolTip="Store codes, comma-separated" automation:AutomationProperties.Name="Store filter"/><TextBox x:Name="BrandSegmentFilterInput" Width="145" Padding="6" Margin="0,0,8,0" ToolTip="Brand segments, comma-separated" automation:AutomationProperties.Name="Brand segment filter"/><TextBox x:Name="TransactionTypeFilterInput" Width="145" Padding="6" Margin="0,0,8,0" ToolTip="Transaction types, comma-separated" automation:AutomationProperties.Name="Transaction type filter"/><TextBox x:Name="ItemFilterInput" Width="145" Padding="6" ToolTip="Item codes, comma-separated" automation:AutomationProperties.Name="Item filter"/></WrapPanel>
        <TextBlock Text="Sales and invoice reports" FontWeight="SemiBold" Margin="0,8,0,4"/>
        <UniformGrid Columns="5"><Button Content="Daily Sales / DSR" Tag="dsr" Click="RunCatalogueReport_Click" Padding="12,8" Margin="3"/><Button Content="Titan Sales Summary" Tag="sales-titan" Click="RunCatalogueReport_Click" Padding="12,8" Margin="3"/><Button Content="Helios Sales Summary" Tag="sales-helios" Click="RunCatalogueReport_Click" Padding="12,8" Margin="3"/><Button Content="Combined Sales Summary" Tag="sales-combined" Click="RunCatalogueReport_Click" Padding="12,8" Margin="3"/><Button Content="Invoice Summary" Tag="invoice" Click="RunCatalogueReport_Click" Padding="12,8" Margin="3"/><Button Content="Returns" Tag="sales-returns" Click="RunCatalogueReport_Click" Padding="12,8" Margin="3"/><Button Content="Brand-wise Sales" Tag="sales-brand" Click="RunCatalogueReport_Click" Padding="12,8" Margin="3"/><Button Content="Brand-Segment Sales" Tag="sales-segment" Click="RunCatalogueReport_Click" Padding="12,8" Margin="3"/><Button Content="Item-wise Sales" Tag="sales-item" Click="RunCatalogueReport_Click" Padding="12,8" Margin="3"/><Button Content="LY / TY Comparison" Tag="dsr" Click="RunCatalogueReport_Click" Padding="12,8" Margin="3"/></UniformGrid>
        <TextBlock Text="Stock reports" FontWeight="SemiBold" Margin="0,12,0,4"/>
        <UniformGrid Columns="5"><Button Content="Closing Stock" Tag="stock-closing" Click="RunCatalogueReport_Click" Padding="12,8" Margin="3"/><Button Content="Physical Stock" Tag="stock-physical" Click="RunCatalogueReport_Click" Padding="12,8" Margin="3"/><Button Content="Stock Variance" Tag="stock-variance" Click="RunCatalogueReport_Click" Padding="12,8" Margin="3"/><Button Content="Stock Movement" Tag="stock-movement" Click="RunCatalogueReport_Click" Padding="12,8" Margin="3"/><Button Content="Inventory-Group Report" Tag="stock-group" Click="RunCatalogueReport_Click" Padding="12,8" Margin="3"/><Button Content="Brand Stock" Tag="stock-brand" Click="RunCatalogueReport_Click" Padding="12,8" Margin="3"/><Button Content="Slow / Exception Stock" Tag="stock-slow" Click="RunCatalogueReport_Click" Padding="12,8" Margin="3"/></UniformGrid>
        <TextBlock Text="Staff and target reports" FontWeight="SemiBold" Margin="0,12,0,4"/>
        <UniformGrid Columns="5"><Button Content="Staff Performance" Tag="staff" Click="RunCatalogueReport_Click" Padding="12,8" Margin="3"/><Button Content="Targets &amp; Achievement" Tag="staff" Click="RunCatalogueReport_Click" Padding="12,8" Margin="3"/><Button Content="Ranking" Tag="staff" Click="RunCatalogueReport_Click" Padding="12,8" Margin="3"/><Button Content="LY Comparison" Tag="staff" Click="RunCatalogueReport_Click" Padding="12,8" Margin="3"/><Button Content="Contribution" Tag="staff" Click="RunCatalogueReport_Click" Padding="12,8" Margin="3"/></UniformGrid>
        <TextBlock Text="Tender, cash and service" FontWeight="SemiBold" Margin="0,12,0,4"/>
        <UniformGrid Columns="5"><Button Content="Tender Reconciliation" Tag="tender" Click="RunCatalogueReport_Click" Padding="12,8" Margin="3"/><Button Content="Tender Exceptions" Tag="exception-tender" Click="RunCatalogueReport_Click" Padding="12,8" Margin="3"/><Button Content="Daily Cash Reconciliation" Tag="cash" Click="RunCatalogueReport_Click" Padding="12,8" Margin="3"/><Button Content="Service Sales" Tag="service" Click="RunCatalogueReport_Click" Padding="12,8" Margin="3"/><Button Content="Tender Diagnostics" Tag="tender-diagnostic" Click="RunCatalogueReport_Click" Padding="12,8" Margin="3"/></UniformGrid>
        <TextBlock Text="Exceptions and management" FontWeight="SemiBold" Margin="0,12,0,4"/>
        <UniformGrid Columns="5"><Button Content="Daily Exception Report" Tag="exceptions" Click="RunCatalogueReport_Click" Padding="12,8" Margin="3"/><Button Content="Missing Source Report" Tag="exception-source" Click="RunCatalogueReport_Click" Padding="12,8" Margin="3"/><Button Content="Unmapped Data" Tag="exception-unmapped" Click="RunCatalogueReport_Click" Padding="12,8" Margin="3"/><Button Content="Stock Exceptions" Tag="exception-stock" Click="RunCatalogueReport_Click" Padding="12,8" Margin="3"/><Button Content="Staff Exceptions" Tag="exception-staff" Click="RunCatalogueReport_Click" Padding="12,8" Margin="3"/><Button Content="Management Trend" Tag="management-trend" Click="RunCatalogueReport_Click" Padding="12,8" Margin="3"/><Button Content="Invoice Source Drill-down" Tag="invoice-lineage" Click="RunCatalogueReport_Click" Padding="12,8" Margin="3"/></UniformGrid>
        <WrapPanel Margin="0,12,0,0"><Button x:Name="ExportExcelButton" Content="Export selected report to Excel…" Click="ExportExcel_Click" Padding="16,8" IsEnabled="False"/><Button x:Name="ExportPdfButton" Content="Export selected report to PDF…" Click="ExportPdf_Click" Padding="16,8" Margin="10,0,0,0" IsEnabled="False"/></WrapPanel>
        <WrapPanel Margin="0,10,0,0"><TextBox x:Name="ReportSearchInput" Width="260" Padding="6" TextChanged="ReportSearch_TextChanged" automation:AutomationProperties.Name="Search report results"/><CheckBox x:Name="VarianceOnlyInput" Content="Variance only" Margin="14,6,0,0" Checked="ReportSearch_TextChanged" Unchecked="ReportSearch_TextChanged" automation:AutomationProperties.Name="Show variance rows only"/><TextBlock Text="Column headers can be clicked to sort. Double-click a row for details." Margin="16,6,0,0" Foreground="#5D6873"/></WrapPanel>
        <TextBlock x:Name="ReportResult" Margin="0,12,0,0" TextWrapping="Wrap" automation:AutomationProperties.Name="Report status" automation:AutomationProperties.LiveSetting="Polite"/>
        <reports:ReportPresentationControl x:Name="ReportPresentationHost" Margin="0,12,0,0" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top" automation:AutomationProperties.Name="Visual report summary and analysis"/>
        <DataGrid x:Name="ReportGrid" Margin="0,12,0,0" AutoGenerateColumns="True" IsReadOnly="True" MaxHeight="360" MouseDoubleClick="ReportGrid_MouseDoubleClick" automation:AutomationProperties.Name="Report results"/>
    </StackPanel>
</UserControl>
