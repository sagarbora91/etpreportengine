<UserControl x:Class="Etp.Reporting.Desktop.Modules.Reports.ReportsWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             xmlns:reports="clr-namespace:Etp.Reporting.Desktop.Modules.Reports"
             automation:AutomationProperties.Name="Reports workspace">
    <StackPanel>
        <TextBlock Text="Report range and filters" FontWeight="SemiBold"/>
        <Border Style="{DynamicResource InsetCard}" Margin="0,8,0,8"><StackPanel>
        <WrapPanel Margin="0,8,0,6"><StackPanel Margin="0,0,8,0"><TextBlock Text="From" Style="{DynamicResource FieldLabelText}"/><DatePicker x:Name="ReportFrom" Width="155" automation:AutomationProperties.Name="Report start date"/></StackPanel><StackPanel Margin="0,0,8,0"><TextBlock Text="To" Style="{DynamicResource FieldLabelText}"/><DatePicker x:Name="ReportTo" Width="155" automation:AutomationProperties.Name="Report end date"/></StackPanel><StackPanel><TextBlock Text="View by" Style="{DynamicResource FieldLabelText}"/><ComboBox x:Name="SalesDimensionInput" Width="160" SelectedIndex="0" automation:AutomationProperties.Name="Sales dimension"><ComboBoxItem Content="Daily"/><ComboBoxItem Content="Store"/><ComboBoxItem Content="Brand"/><ComboBoxItem Content="BrandSegment"/><ComboBoxItem Content="Item"/><ComboBoxItem Content="Returns"/></ComboBox></StackPanel></WrapPanel>
        <WrapPanel Margin="0,0,0,8"><StackPanel Margin="0,0,8,0"><TextBlock Text="Stores" Style="{DynamicResource FieldLabelText}"/><TextBox x:Name="StoreFilterInput" Width="120" Padding="6" ToolTip="Store codes, comma-separated" automation:AutomationProperties.Name="Store filter"/></StackPanel><StackPanel Margin="0,0,8,0"><TextBlock Text="Brand segments" Style="{DynamicResource FieldLabelText}"/><TextBox x:Name="BrandSegmentFilterInput" Width="145" Padding="6" ToolTip="Brand segments, comma-separated" automation:AutomationProperties.Name="Brand segment filter"/></StackPanel><StackPanel Margin="0,0,8,0"><TextBlock Text="Transaction types" Style="{DynamicResource FieldLabelText}"/><TextBox x:Name="TransactionTypeFilterInput" Width="145" Padding="6" ToolTip="Transaction types, comma-separated" automation:AutomationProperties.Name="Transaction type filter"/></StackPanel><StackPanel><TextBlock Text="Items" Style="{DynamicResource FieldLabelText}"/><TextBox x:Name="ItemFilterInput" Width="145" Padding="6" ToolTip="Item codes, comma-separated" automation:AutomationProperties.Name="Item filter"/></StackPanel></WrapPanel>
        </StackPanel></Border>
        <TextBlock Text="Sales and invoice reports" FontWeight="SemiBold" Margin="0,8,0,4"/>
        <UniformGrid Columns="5"><Button Content="Daily Sales / DSR" Tag="dsr" Click="RunCatalogueReport_Click" Style="{DynamicResource PrimaryButton}" Padding="12,8" Margin="3"/><Button Content="Titan Sales Summary" Tag="sales-titan" Click="RunCatalogueReport_Click" Padding="12,8" Margin="3"/><Button Content="Helios Sales Summary" Tag="sales-helios" Click="RunCatalogueReport_Click" Padding="12,8" Margin="3"/><Button Content="Combined Sales Summary" Tag="sales-combined" Click="RunCatalogueReport_Click" Padding="12,8" Margin="3"/><Button Content="Invoice Summary" Tag="invoice" Click="RunCatalogueReport_Click" Padding="12,8" Margin="3"/><Button Content="Returns" Tag="sales-returns" Click="RunCatalogueReport_Click" Padding="12,8" Margin="3"/><Button Content="Brand-wise Sales" Tag="sales-brand" Click="RunCatalogueReport_Click" Padding="12,8" Margin="3"/><Button Content="Brand-Segment Sales" Tag="sales-segment" Click="RunCatalogueReport_Click" Padding="12,8" Margin="3"/><Button Content="Item-wise Sales" Tag="sales-item" Click="RunCatalogueReport_Click" Padding="12,8" Margin="3"/><Button Content="LY / TY Comparison" Tag="dsr" Click="RunCatalogueReport_Click" Padding="12,8" Margin="3"/></UniformGrid>
        <TextBlock Text="Stock reports" FontWeight="SemiBold" Margin="0,12,0,4"/>
        <UniformGrid Columns="5"><Button Content="Closing Stock" Tag="stock-closing" Click="RunCatalogueReport_Click" Padding="12,8" Margin="3"/><Button Content="Physical Stock" Tag="stock-physical" Click="RunCatalogueReport_Click" Padding="12,8" Margin="3"/><Button Content="Stock Variance" Tag="stock-variance" Click="RunCatalogueReport_Click" Padding="12,8" Margin="3"/><Button Content="Stock Movement" Tag="stock-movement" Click="RunCatalogueReport_Click" Padding="12,8" Margin="3"/><Button Content="Brand Stock" Tag="stock-brand" Click="RunCatalogueReport_Click" Padding="12,8" Margin="3"/><Button Content="Slow / Exception Stock" Tag="stock-slow" Click="RunCatalogueReport_Click" Padding="12,8" Margin="3"/></UniformGrid>
        <TextBlock Text="Staff and target reports" FontWeight="SemiBold" Margin="0,12,0,4"/>
        <UniformGrid Columns="5"><Button Content="Staff Performance" Tag="staff" Click="RunCatalogueReport_Click" Padding="12,8" Margin="3"/><Button Content="Targets &amp; Achievement" Tag="staff" Click="RunCatalogueReport_Click" Padding="12,8" Margin="3"/><Button Content="Ranking" Tag="staff" Click="RunCatalogueReport_Click" Padding="12,8" Margin="3"/><Button Content="LY Comparison" Tag="staff" Click="RunCatalogueReport_Click" Padding="12,8" Margin="3"/><Button Content="Contribution" Tag="staff" Click="RunCatalogueReport_Click" Padding="12,8" Margin="3"/></UniformGrid>
        <TextBlock Text="Tender, cash and service" FontWeight="SemiBold" Margin="0,12,0,4"/>
        <UniformGrid Columns="5"><Button Content="Tender Reconciliation" Tag="tender" Click="RunCatalogueReport_Click" Padding="12,8" Margin="3"/><Button Content="Daily Cash Reconciliation" Tag="cash" Click="RunCatalogueReport_Click" Padding="12,8" Margin="3"/><Button Content="Service Sales" Tag="service" Click="RunCatalogueReport_Click" Padding="12,8" Margin="3"/><Button Content="Tender Diagnostics" Tag="tender-diagnostic" Click="RunCatalogueReport_Click" Padding="12,8" Margin="3"/></UniformGrid>
        <TextBlock Text="Exceptions and management" FontWeight="SemiBold" Margin="0,12,0,4"/>
        <UniformGrid Columns="5"><Button Content="Daily Exception Report" Tag="exceptions" Click="RunCatalogueReport_Click" Padding="12,8" Margin="3"/><Button Content="Management Trend" Tag="management-trend" Click="RunCatalogueReport_Click" Padding="12,8" Margin="3"/><Button Content="Invoice Source Drill-down" Tag="invoice-lineage" Click="RunCatalogueReport_Click" Padding="12,8" Margin="3"/></UniformGrid>
        <WrapPanel Margin="0,12,0,0"><Button x:Name="ExportExcelButton" Content="Export selected report to Excel…" Click="ExportExcel_Click" Padding="16,8" IsEnabled="False"/><Button x:Name="ExportPdfButton" Content="Export selected report to PDF…" Click="ExportPdf_Click" Padding="16,8" Margin="10,0,0,0" IsEnabled="False"/></WrapPanel>
        <WrapPanel Margin="0,10,0,0"><TextBox x:Name="ReportSearchInput" Width="260" Padding="6" TextChanged="ReportSearch_TextChanged" automation:AutomationProperties.Name="Search report results"/><CheckBox x:Name="VarianceOnlyInput" Content="Variance only" Margin="14,6,0,0" Checked="ReportSearch_TextChanged" Unchecked="ReportSearch_TextChanged" automation:AutomationProperties.Name="Show variance rows only"/><Button Content="View selected details" Click="ViewDetails_Click" Margin="14,0,0,0" automation:AutomationProperties.Name="View selected report row details"/><TextBlock Text="Select a row, then open details and source lineage." Margin="16,6,0,0" Foreground="{DynamicResource SecondaryText}"/></WrapPanel>
        <Border Style="{DynamicResource StatusBanner}" Margin="0,12,0,0"><TextBlock x:Name="ReportResult" TextWrapping="Wrap" automation:AutomationProperties.Name="Report status" automation:AutomationProperties.LiveSetting="Polite"/></Border>
        <reports:ReportPresentationControl x:Name="ReportPresentationHost" Margin="0,12,0,0" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top" automation:AutomationProperties.Name="Visual report summary and analysis"/>
        <WrapPanel x:Name="ExceptionFilters" Visibility="Collapsed" Margin="0,8,0,0"><Button Content="All" Tag="All" Click="ExceptionFilter_Click" MinHeight="44" Margin="4"/><Button Content="Source" Tag="Source" Click="ExceptionFilter_Click" MinHeight="44" Margin="4"/><Button Content="Unmapped" Tag="Unmapped" Click="ExceptionFilter_Click" MinHeight="44" Margin="4"/><Button Content="Stock" Tag="Stock" Click="ExceptionFilter_Click" MinHeight="44" Margin="4"/><Button Content="Staff" Tag="Staff" Click="ExceptionFilter_Click" MinHeight="44" Margin="4"/><Button Content="Tender" Tag="Tender" Click="ExceptionFilter_Click" MinHeight="44" Margin="4"/><Button Content="Cash" Tag="Cash" Click="ExceptionFilter_Click" MinHeight="44" Margin="4"/><TextBlock Text="Filters affect the visible list. Exports retain all exceptions." TextWrapping="Wrap"/></WrapPanel>
        <DataGrid x:Name="ReportGrid" Margin="0,12,0,0" AutoGenerateColumns="True" IsReadOnly="True" MaxHeight="360" MouseDoubleClick="ReportGrid_MouseDoubleClick" automation:AutomationProperties.Name="Report results"/>
    </StackPanel>
</UserControl>
