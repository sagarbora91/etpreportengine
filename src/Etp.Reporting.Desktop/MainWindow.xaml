<Window x:Class="Etp.Reporting.Desktop.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
 Title="ETP Reporting Engine" Width="1366" Height="768" MinWidth="640" MinHeight="400"
 WindowState="Maximized" Background="{DynamicResource AppBackground}"
 SizeChanged="MainWindow_SizeChanged" PreviewKeyDown="MainWindow_PreviewKeyDown">
 <Grid Background="{DynamicResource AppBackground}">
  <Grid.ColumnDefinitions><ColumnDefinition x:Name="RailColumn" Width="112"/><ColumnDefinition/></Grid.ColumnDefinitions>
  <Border Background="{DynamicResource NavigationBackground}">
   <StackPanel x:Name="RailPanel" Margin="4,8" automation:AutomationProperties.Name="Main sections">
    <TextBlock Text="ETP" Foreground="{DynamicResource NavigationMuted}" FontWeight="Bold" FontSize="22" Margin="10,4,0,16"/>
    <Button Content="Today" Tag="Today" Click="Section_Click" Margin="0,3" Padding="4"/>
    <Button Content="Import" Tag="Import" Click="Section_Click" Margin="0,3" Padding="4"/>
    <Button Content="Reports" Tag="Reports" Click="Section_Click" Margin="0,3" Padding="4"/>
    <Button Content="Stock" Tag="Stock" Click="Section_Click" Margin="0,3" Padding="4"/>
    <Button Content="Settings" Tag="Settings" Click="Section_Click" Margin="0,3" Padding="4"/>
    <Button Content="⌕ Search" Click="OpenGlobalSearch_Click" Margin="0,16,0,0" Padding="4" automation:AutomationProperties.Name="Find a screen"/>
    <Button Content="More details" Click="StatusDetails_Click" Margin="0,4" Padding="4" automation:AutomationProperties.Name="Read full status"/>
    <TextBlock x:Name="AttentionBadge" Foreground="{DynamicResource NavigationMuted}" TextWrapping="Wrap" Margin="6" Visibility="Collapsed" automation:AutomationProperties.LiveSetting="Polite"/>
   </StackPanel>
  </Border>
  <Grid Grid.Column="1">
   <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="28"/></Grid.RowDefinitions>
   <Grid Background="{DynamicResource Surface}" Margin="8,0">
    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="180"/><ColumnDefinition Width="170"/></Grid.ColumnDefinitions>
    <TextBlock x:Name="PageTitle" Text="Today" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" automation:AutomationProperties.HeadingLevel="Level1"/>
    <DatePicker x:Name="ShellBusinessDateSelector" Grid.Column="1" Margin="2" SelectedDateChanged="ShellBusinessDate_Changed" automation:AutomationProperties.Name="Business date"/>
    <ComboBox x:Name="ShellStoreSelector" Grid.Column="2" SelectedIndex="2" Margin="2" automation:AutomationProperties.Name="Store">
     <ComboBoxItem Content="Titan World"/><ComboBoxItem Content="Helios"/><ComboBoxItem Content="Both stores"/>
    </ComboBox>
   </Grid>
   <WrapPanel x:Name="SectionTabs" Grid.Row="1" Margin="8,2" automation:AutomationProperties.Name="Section tabs"/>
   <Border x:Name="FocusedWorkspaceLayer" Grid.Row="2" Background="{DynamicResource AppBackground}">
    <ContentControl x:Name="FocusedWorkspaceHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
   </Border>
   <Border x:Name="StatusFooter" Grid.Row="3" Background="{DynamicResource Surface}" Padding="8,0" Focusable="True" automation:AutomationProperties.Name="Application status">
    <TextBlock x:Name="ApplicationStatus" Text="Starting…" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" automation:AutomationProperties.LiveSetting="Polite" MouseDown="Status_Click"/>
   </Border>
  </Grid>
  <Border x:Name="SuccessToast" Grid.Column="1" Panel.ZIndex="25" Visibility="Collapsed" Background="{DynamicResource SuccessSoft}" BorderBrush="{DynamicResource Success}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="12,0,12,40" VerticalAlignment="Bottom" HorizontalAlignment="Right" MaxWidth="520">
   <StackPanel><TextBlock x:Name="ToastMessage" MaxHeight="60" TextWrapping="Wrap" automation:AutomationProperties.LiveSetting="Polite"/><Button Content="More details" Click="StatusDetails_Click" HorizontalAlignment="Right" Margin="0,4,0,0"/></StackPanel>
  </Border>
  <Grid x:Name="DrawerOverlay" Grid.Column="1" Background="#550C1628" Visibility="Collapsed" Panel.ZIndex="40" MouseDown="DrawerOverlay_MouseDown">
   <Border x:Name="DetailDrawerHost" Width="390" HorizontalAlignment="Right" Background="{DynamicResource Surface}" Padding="16" MouseDown="DetailDrawerHost_MouseDown"/>
  </Grid>
  <Grid x:Name="WelcomeOverlay" Grid.ColumnSpan="2" Background="{DynamicResource AppBackground}" Panel.ZIndex="100">
   <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="480" Margin="24">
    <TextBlock Text="Database setup" FontSize="24" FontWeight="SemiBold"/>
    <TextBlock x:Name="WelcomeIdentityText" Text="Checking connection…" Margin="0,12" TextWrapping="Wrap"/>
    <TextBlock x:Name="WelcomeRoleText" Text="Checking access…" TextWrapping="Wrap"/>
    <ProgressBar x:Name="WelcomeProgress" IsIndeterminate="True" Margin="0,12"/>
    <Button x:Name="ContinueButton" Content="Open database setup" IsEnabled="False" Click="Continue_Click"/>
    <TextBlock x:Name="WelcomeMessage" Margin="0,12" TextWrapping="Wrap"/>
   </StackPanel>
  </Grid>
 </Grid>
</Window>
