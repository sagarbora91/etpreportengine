                            <WrapPanel><ComboBox x:Name="MasterTypeInput" Width="150" SelectedIndex="0" SelectionChanged="MasterType_SelectionChanged" automation:AutomationProperties.Name="Master data type"><ComboBoxItem Content="Store"/><ComboBoxItem Content="Brand Segment"/><ComboBoxItem Content="Inventory Group"/><ComboBoxItem Content="Tender"/></ComboBox><TextBox x:Name="MasterCodeInput" Width="130" Padding="6" Margin="8,0,0,0" ToolTip="Master code" automation:AutomationProperties.Name="Master code"/><TextBox x:Name="MasterNameInput" Width="210" Padding="6" Margin="8,0,0,0" ToolTip="Display name" automation:AutomationProperties.Name="Master display name"/><ComboBox x:Name="MasterApprovalInput" Width="130" SelectedIndex="0" Margin="8,0,0,0" automation:AutomationProperties.Name="Master approval status"><ComboBoxItem Content="Observed"/><ComboBoxItem Content="Approved"/><ComboBoxItem Content="Quarantined"/></ComboBox><CheckBox x:Name="MasterActiveInput" Content="Active" IsChecked="True" Margin="8,5,0,0"/><TextBox x:Name="MasterReasonInput" Width="200" Padding="6" Margin="8,0,0,0" ToolTip="Owner reason required" automation:AutomationProperties.Name="Master change reason"/><Button Content="Save master" Click="SaveMaster_Click" Padding="14,7" Margin="8,0,0,0"/></WrapPanel>
                            <DataGrid x:Name="ControlledMastersGrid" AutoGenerateColumns="True" IsReadOnly="True" MaxHeight="220" Margin="0,10,0,0" automation:AutomationProperties.Name="Controlled master values"/>
                            <Separator Margin="0,16,0,12"/><TextBlock Text="Windows-integrated users" FontWeight="SemiBold"/><TextBlock Text="Use DOMAIN\User or COMPUTER\User. Store Managers may import and enter operational data; only Owners can administer configuration and mappings." Margin="0,5,0,8" Foreground="#5D6873" TextWrapping="Wrap"/>
                            <WrapPanel><TextBox x:Name="UserIdentityInput" Width="190" Padding="6" ToolTip="Windows identity" automation:AutomationProperties.Name="Windows user identity"/><TextBox x:Name="UserDisplayNameInput" Width="180" Padding="6" Margin="8,0,0,0" ToolTip="Display name" automation:AutomationProperties.Name="User display name"/><ComboBox x:Name="UserRoleInput" Width="150" SelectedIndex="1" Margin="8,0,0,0" automation:AutomationProperties.Name="Application role"><ComboBoxItem Content="Owner"/><ComboBoxItem Content="Store Manager"/><ComboBoxItem Content="Viewer"/></ComboBox><CheckBox x:Name="UserActiveInput" Content="Active" IsChecked="True" Margin="8,5,0,0"/><TextBox x:Name="UserReasonInput" Width="210" Padding="6" Margin="8,0,0,0" ToolTip="Owner reason required" automation:AutomationProperties.Name="User access change reason"/><Button Content="Save user access" Click="SaveUserAccess_Click" Padding="14,7" Margin="8,0,0,0"/></WrapPanel>
                             <DataGrid x:Name="ApplicationUsersGrid" AutoGenerateColumns="True" IsReadOnly="True" MaxHeight="220" Margin="0,10,0,0" automation:AutomationProperties.Name="Application users"/>
                            <Separator Margin="0,16,0,12"/><TextBlock Text="Business rule and KPI catalogue" FontWeight="SemiBold"/><DataGrid x:Name="KpiCatalogueGrid" AutoGenerateColumns="True" IsReadOnly="True" MaxHeight="220" Margin="0,8,0,0" automation:AutomationProperties.Name="Business rule and KPI catalogue"/><TextBlock Text="Product integration health" FontWeight="SemiBold" Margin="0,14,0,6"/><DataGrid x:Name="ProductHealthGrid" AutoGenerateColumns="True" IsReadOnly="True" MaxHeight="180" automation:AutomationProperties.Name="Product integration health"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
            <Border x:Name="FocusedWorkspaceLayer" Grid.Row="1" Background="{StaticResource AppBackground}" Visibility="Collapsed" Panel.ZIndex="15" automation:AutomationProperties.Name="Focused application workspace">
                <ContentControl x:Name="FocusedWorkspaceHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
            </Border>
            <Border Grid.Row="2" Background="{StaticResource Surface}" BorderBrush="{StaticResource Divider}" BorderThickness="0,1,0,0" Padding="24,9"><DockPanel><Button DockPanel.Dock="Right" x:Name="DensityToggleButton" Content="Comfortable" Click="ToggleDensity_Click" Padding="10,3" MinHeight="30" automation:AutomationProperties.Name="Switch interface density"/><TextBlock x:Name="ApplicationStatus" Text="Starting ETP Reporting Engine…" Foreground="#465563" VerticalAlignment="Center" automation:AutomationProperties.LiveSetting="Polite" automation:AutomationProperties.Name="Application status"/></DockPanel></Border>
        </Grid>
        <Grid x:Name="DrawerOverlay" Grid.Column="2" Background="#550C1628" Visibility="Collapsed" Panel.ZIndex="40" MouseDown="DrawerOverlay_MouseDown"><Border x:Name="DetailDrawerHost" Width="390" HorizontalAlignment="Right" Background="{StaticResource Surface}" Padding="22" MouseDown="DetailDrawerHost_MouseDown" automation:AutomationProperties.Name="Detail and source evidence drawer"/></Grid>
        <Grid x:Name="WelcomeOverlay" Grid.ColumnSpan="3" Background="#F7F9FC" Panel.ZIndex="100" automation:AutomationProperties.Name="ETP Reporting Engine welcome and Windows identity sign in">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="480"/></Grid.ColumnDefinitions><Border Background="{StaticResource NavigationBackground}"><StackPanel VerticalAlignment="Center" Margin="70"><Image Source="Assets/EtpReporting.ico" Width="74" Height="74" HorizontalAlignment="Left"/><TextBlock Text="ETP Reporting Engine" Foreground="White" FontSize="30" FontWeight="SemiBold" Margin="0,24,0,0"/><TextBlock Text="Retail reporting and business control" Foreground="#A9B6CC" FontSize="14" Margin="0,7,0,0"/></StackPanel></Border><StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="60"><TextBlock Text="Welcome back" Style="{StaticResource DisplayText}"/><TextBlock Text="Continue securely with your Windows identity." Style="{StaticResource BodyText}" Margin="0,8,0,26"/><TextBlock Text="Windows user" Style="{StaticResource CaptionText}"/><TextBlock x:Name="WelcomeIdentityText" Text="Checking identity…" FontSize="15" FontWeight="SemiBold" Margin="0,6,0,18"/><TextBlock Text="Role" Style="{StaticResource CaptionText}"/><TextBlock x:Name="WelcomeRoleText" Text="Checking access…" FontSize="15" FontWeight="SemiBold" Margin="0,6,0,24"/><ProgressBar x:Name="WelcomeProgress" IsIndeterminate="True" Height="7"/><Button x:Name="ContinueButton" Content="Continue" Style="{StaticResource PrimaryButton}" Margin="0,20,0,0" IsEnabled="False" Click="Continue_Click" automation:AutomationProperties.Name="Continue with Windows identity"/><TextBlock x:Name="WelcomeMessage" Text="Loading your reporting workspace…" Style="{StaticResource CaptionText}" Margin="0,12,0,0"/></StackPanel>
        </Grid>
    </Grid>
</Window>
