<Window x:Class="Etp.Reporting.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        Title="ETP Reporting Engine" Icon="Assets/EtpReporting.ico" WindowState="Maximized" Height="720" Width="1280" MinHeight="480" MinWidth="816"
        KeyboardNavigation.TabNavigation="Continue" KeyboardNavigation.ControlTabNavigation="Continue"
        WindowStartupLocation="CenterScreen" Background="{StaticResource AppBackground}"
        PreviewKeyDown="MainWindow_PreviewKeyDown" SizeChanged="MainWindow_SizeChanged">
    <Window.Resources>
        <Style x:Key="NavigationButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="20,13"/><Setter Property="Margin" Value="8,2"/><Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#164651"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Background" Value="{StaticResource NavigationSelected}"/></Trigger></Style.Triggers>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Surface}"/><Setter Property="BorderBrush" Value="{StaticResource Divider}"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/><Setter Property="Padding" Value="18"/><Setter Property="Effect" Value="{StaticResource CardShadow}"/>
        </Style>
    </Window.Resources>
    <Grid x:Name="AppShellRoot" Background="{StaticResource AppBackground}">
        <Grid.ColumnDefinitions><ColumnDefinition x:Name="RailColumn" Width="70"/><ColumnDefinition x:Name="SidebarColumn" Width="0"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <DockPanel Grid.Column="0" Background="{StaticResource NavigationBackground}" Panel.ZIndex="30">
            <StackPanel DockPanel.Dock="Top" Margin="0,10"><Border Width="42" Height="42" CornerRadius="12" Background="{StaticResource NavigationSelected}" Margin="0,4,0,10"><Image Source="Assets/EtpReporting.ico" Width="30" Height="30" automation:AutomationProperties.Name="ETP Reporting Engine logo"/></Border><Button ToolTip="Modules Home" Click="ShowModuleHome_Click" Style="{StaticResource RailButton}" automation:AutomationProperties.Name="Open Modules Home"><Path Data="{StaticResource IconHome}" Stroke="{StaticResource NavigationMuted}" StrokeThickness="1.7" Stretch="Uniform"/></Button><Button ToolTip="Global Search" Tag="Operations Center" Click="OpenGlobalSearch_Click" Style="{StaticResource RailButton}" automation:AutomationProperties.Name="Open Global Search"><Path Data="{StaticResource IconSearch}" Stroke="{StaticResource NavigationMuted}" StrokeThickness="1.7" Stretch="Uniform"/></Button></StackPanel>
            <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,10"><Button ToolTip="Help" Click="OpenHelp_Click" Style="{StaticResource RailButton}" automation:AutomationProperties.Name="Open Help"><Path Data="{StaticResource IconHelp}" Stroke="{StaticResource NavigationMuted}" StrokeThickness="1.7" Stretch="Uniform"/></Button><Button ToolTip="Settings" Tag="Admin / Settings" Click="Navigate_Click" Style="{StaticResource RailButton}" automation:AutomationProperties.Name="Open Settings"><Path Data="{StaticResource IconSettings}" Stroke="{StaticResource NavigationMuted}" StrokeThickness="1.7" Stretch="Uniform"/></Button><Button ToolTip="Profile" Click="OpenProfile_Click" Style="{StaticResource RailButton}" automation:AutomationProperties.Name="Open Profile"><Path Data="{StaticResource IconUser}" Stroke="{StaticResource NavigationMuted}" StrokeThickness="1.7" Stretch="Uniform"/></Button></StackPanel>
        </DockPanel>
        <Border x:Name="ContextSidebar" Grid.Column="1" Background="{StaticResource Surface}" BorderBrush="{StaticResource Divider}" BorderThickness="0,0,1,0" Panel.ZIndex="20" automation:AutomationProperties.Name="Contextual module navigation">
            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Margin="16,18,16,12"><DockPanel><Button DockPanel.Dock="Right" Content="‹" Width="40" Padding="0" Click="ToggleSidebar_Click" ToolTip="Collapse sidebar" automation:AutomationProperties.Name="Collapse contextual sidebar"/><StackPanel><TextBlock x:Name="SidebarModuleTitle" Text="Modules" FontSize="19" FontWeight="SemiBold" Foreground="{StaticResource PrimaryText}"/><TextBlock x:Name="SidebarModuleSubtitle" Text="Choose a workspace" Style="{StaticResource CaptionText}"/></StackPanel></DockPanel><TextBox x:Name="SidebarSearchInput" Margin="0,14,0,0" TextChanged="SidebarSearch_TextChanged" automation:AutomationProperties.Name="Find a page or report" ToolTip="Find a page or report"/></StackPanel>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="SidebarItemsPanel" Margin="8,0,8,12"/></ScrollViewer>
                <Button Grid.Row="2" Content="← Back to Modules" Click="ShowModuleHome_Click" Style="{StaticResource SidebarItemButton}" Margin="12" automation:AutomationProperties.Name="Back to Modules Home"/>
            </Grid>
        </Border>
        <Grid Grid.Column="2">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Border Grid.Row="0" Background="{StaticResource Surface}" BorderBrush="{StaticResource Divider}" BorderThickness="0,0,0,1" Padding="12,8">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock x:Name="BreadcrumbText" Visibility="Collapsed"/><TextBlock x:Name="PageTitle" Text="Modules" FontSize="22" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="PageDescription" Visibility="Collapsed"/></StackPanel>
                    <ContentControl x:Name="HeaderSearchHost" Grid.Column="1" VerticalAlignment="Center"/>
                    <Button x:Name="SidebarToggleButton" Grid.Column="2" Content="Tasks" Click="ToggleSidebar_Click" Visibility="Collapsed"/>
                    <DockPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,6,0,0">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><ComboBox x:Name="ShellStoreSelector" Width="160" SelectedIndex="2" Margin="6,0" automation:AutomationProperties.Name="Current store"><ComboBoxItem Content="Titan World"/><ComboBoxItem Content="Helios"/><ComboBoxItem Content="All authorised stores"/></ComboBox><DatePicker x:Name="ShellBusinessDateSelector" Width="150" SelectedDateChanged="ShellBusinessDate_Changed" automation:AutomationProperties.Name="Business date"/><TextBlock x:Name="AccessStatus" Visibility="Collapsed"/></StackPanel>
                        <WrapPanel x:Name="BreadcrumbLinks"/>
                    </DockPanel>
                </Grid>
            </Border>
            <ScrollViewer x:Name="LegacyWorkspaceScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="WorkspaceStack" Margin="24">
                    <UniformGrid x:Name="ReadinessSummaryPanel" Columns="2" Margin="0,0,0,20">
                        <Border Style="{StaticResource Card}" Margin="0,0,10,0"><StackPanel><TextBlock Text="Database connection" FontWeight="SemiBold" Foreground="#344454"/><TextBlock x:Name="ConnectionStatus" Text="Not configured" FontSize="20" FontWeight="SemiBold" Foreground="#9B5C00" Margin="0,10,0,4" automation:AutomationProperties.Name="Database connection status: Not configured"/><TextBlock Text="Configure SQL Server in Settings before importing data." TextWrapping="Wrap" Foreground="#5D6873"/></StackPanel></Border>
                        <Border Style="{StaticResource Card}" Margin="10,0,0,0"><StackPanel><TextBlock Text="Import readiness" FontWeight="SemiBold" Foreground="#344454"/><TextBlock x:Name="ImportStatus" Text="Waiting for configuration" FontSize="20" FontWeight="SemiBold" Foreground="#9B5C00" Margin="0,10,0,4" automation:AutomationProperties.Name="Import readiness status: Waiting for configuration"/><TextBlock Text="No workbook has been selected. Unknown layouts will never be guessed." TextWrapping="Wrap" Foreground="#5D6873"/></StackPanel></Border>
                    </UniformGrid>
                    <Border x:Name="GettingStartedPanel" Style="{StaticResource Card}"><StackPanel><TextBlock x:Name="WorkspaceHeading" Text="Getting started" FontSize="18" FontWeight="SemiBold" Foreground="#172B3E"/><TextBlock x:Name="WorkspaceMessage" Text="Open Settings to configure the database, then use Import ETP to select and validate a workbook." TextWrapping="Wrap" Margin="0,10,0,18" Foreground="#44515E"/><Button x:Name="PrimaryAction" Content="Open Settings" Tag="Settings" Click="Navigate_Click" HorizontalAlignment="Left" Style="{StaticResource PrimaryButton}" automation:AutomationProperties.Name="Open Settings"/></StackPanel></Border>
                    <Border x:Name="DashboardPanel" Style="{StaticResource Card}" Background="Transparent" BorderThickness="0" Padding="0" Effect="{x:Null}" Margin="0,0,0,0">
                        <ContentControl x:Name="DashboardHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
                    </Border>
                    <ContentControl x:Name="SettingsPanel" Margin="0,20,0,0" Visibility="Collapsed"
                                    automation:AutomationProperties.Name="Settings workspace host"/>
                    <ContentControl x:Name="DailyWorkflowPanel" Margin="0,20,0,0" Visibility="Collapsed"
                                    automation:AutomationProperties.Name="Daily workflow workspace host"/>
                    <Border x:Name="ImportPanel" Style="{StaticResource Card}" Margin="0,20,0,0" Visibility="Collapsed">
                        <ContentControl x:Name="ImportHost"/>
                    </Border>
                    <Border x:Name="SourceInboxPanel" Style="{StaticResource Card}" Margin="0,20,0,0" Visibility="Collapsed">
                        <ContentControl x:Name="SourceInboxHost"/>
                    </Border>
                    <Border x:Name="ReportsPanel" Style="{StaticResource Card}" Margin="0,20,0,0" Visibility="Collapsed">
                        <ContentControl x:Name="ReportsHost"/>
                    </Border>
                    <Border x:Name="OperationsPanel" Style="{StaticResource Card}" Margin="0,20,0,0" Visibility="Collapsed">
                        <ContentControl x:Name="OperationsHost"/>
                    </Border>
                    <Border x:Name="InvestigationPanel" Style="{StaticResource Card}" Margin="0,20,0,0" Visibility="Collapsed">
                        <ContentControl x:Name="InvestigationHost"/>
                    </Border>
                    <Border x:Name="ReportArchivePanel" Style="{StaticResource Card}" Margin="0,20,0,0" Visibility="Collapsed">
                        <ContentControl x:Name="ReportArchiveHost"/>
                    </Border>
                    <Border x:Name="RegistersPanel" Style="{StaticResource Card}" Margin="0,20,0,0" Visibility="Collapsed">
                        <ContentControl x:Name="RegistersHost"/>
                    </Border>
                    <Border x:Name="AccountingPanel" Style="{StaticResource Card}" Margin="0,20,0,0" Visibility="Collapsed">
                        <ContentControl x:Name="AccountingHost"/>
                    </Border>
                    <Border x:Name="MastersPanel" Style="{StaticResource Card}" Margin="0,20,0,0" Visibility="Collapsed">
                        <ContentControl x:Name="AdministrationHost"/>
                    </Border>
                </StackPanel>
            </ScrollViewer>
            <Border x:Name="FocusedWorkspaceLayer" Grid.Row="1" Background="{StaticResource AppBackground}" Visibility="Collapsed" Panel.ZIndex="15" automation:AutomationProperties.Name="Focused application workspace">
                <ContentControl x:Name="FocusedWorkspaceHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
            </Border>
            <Border Grid.Row="2" Background="{StaticResource Surface}" BorderBrush="{StaticResource Divider}" BorderThickness="0,1,0,0" Padding="24,8"><DockPanel><TextBlock x:Name="ApplicationStatus" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Margin="0,0,12,0" Text="Starting ETP Reporting Engine…" Foreground="{StaticResource SecondaryText}" VerticalAlignment="Center" automation:AutomationProperties.LiveSetting="Polite" automation:AutomationProperties.Name="Application status"/></DockPanel></Border>
        </Grid>
        <Grid x:Name="DrawerOverlay" Grid.Column="2" Background="#550C1628" Visibility="Collapsed" Panel.ZIndex="40" MouseDown="DrawerOverlay_MouseDown"><Border x:Name="DetailDrawerHost" Width="390" HorizontalAlignment="Right" Background="{StaticResource Surface}" Padding="22" MouseDown="DetailDrawerHost_MouseDown" automation:AutomationProperties.Name="Detail and source evidence drawer"/></Grid>
        <Grid x:Name="WelcomeOverlay" FocusManager.IsFocusScope="True" KeyboardNavigation.TabNavigation="Cycle" Grid.ColumnSpan="3" Background="{StaticResource AppBackground}" Panel.ZIndex="100" automation:AutomationProperties.Name="ETP Reporting Engine welcome and Windows identity sign in">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="480"/></Grid.ColumnDefinitions><Border Background="{StaticResource NavigationBackground}"><StackPanel VerticalAlignment="Center" Margin="70"><Image Source="Assets/EtpReporting.ico" Width="74" Height="74" HorizontalAlignment="Left"/><TextBlock Text="ETP Reporting Engine" Foreground="White" FontSize="30" FontWeight="SemiBold" Margin="0,24,0,0"/><TextBlock Text="Retail reporting and business control" Foreground="#A9B6CC" FontSize="14" Margin="0,7,0,0"/></StackPanel></Border><StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="60"><TextBlock Text="Welcome back" Style="{StaticResource DisplayText}"/><TextBlock Text="Continue securely with your Windows identity." Style="{StaticResource BodyText}" Margin="0,8,0,26"/><TextBlock Text="Windows user" Style="{StaticResource CaptionText}"/><TextBlock x:Name="WelcomeIdentityText" Text="Checking identity…" FontSize="15" FontWeight="SemiBold" Margin="0,6,0,18"/><TextBlock Text="Role" Style="{StaticResource CaptionText}"/><TextBlock x:Name="WelcomeRoleText" Text="Checking access…" FontSize="15" FontWeight="SemiBold" Margin="0,6,0,24"/><ProgressBar x:Name="WelcomeProgress" IsIndeterminate="True" Height="7"/><Button x:Name="ContinueButton" Content="Continue" IsDefault="True" Style="{StaticResource PrimaryButton}" Margin="0,20,0,0" IsEnabled="False" Click="Continue_Click" automation:AutomationProperties.Name="Continue with Windows identity"/><TextBlock x:Name="WelcomeMessage" Text="Loading your reporting workspace…" Style="{StaticResource CaptionText}" Margin="0,12,0,0"/></StackPanel>
        </Grid>
    </Grid>
</Window>
