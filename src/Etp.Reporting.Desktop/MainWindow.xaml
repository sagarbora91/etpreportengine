<Window x:Class="Etp.Reporting.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        Title="ETP Reporting Engine" Icon="Assets/EtpReporting.ico" Height="720" Width="1180" MinHeight="600" MinWidth="960"
        KeyboardNavigation.TabNavigation="Continue" KeyboardNavigation.ControlTabNavigation="Continue"
        WindowStartupLocation="CenterScreen" Background="{StaticResource AppBackground}"
        PreviewKeyDown="MainWindow_PreviewKeyDown" SizeChanged="MainWindow_SizeChanged">
    <Window.Resources>
        <Style x:Key="NavigationButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#E8EEF5"/>
            <Setter Property="BorderThickness" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="20,13"/><Setter Property="Margin" Value="8,2"/><Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#263C52"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Background" Value="#31506C"/></Trigger></Style.Triggers>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#DCE2E8"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/><Setter Property="Padding" Value="20"/>
        </Style>
    </Window.Resources>
    <Grid x:Name="AppShellRoot" Background="{StaticResource AppBackground}">
        <Grid.ColumnDefinitions><ColumnDefinition x:Name="RailColumn" Width="72"/><ColumnDefinition x:Name="SidebarColumn" Width="300"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <DockPanel Grid.Column="0" Background="{StaticResource NavigationBackground}" Panel.ZIndex="30">
            <StackPanel DockPanel.Dock="Top" Margin="4,10"><Image Source="Assets/EtpReporting.ico" Width="42" Height="42" Margin="0,4,0,10" automation:AutomationProperties.Name="ETP Reporting Engine logo"/><Button ToolTip="Modules Home" Click="ShowModuleHome_Click" Style="{StaticResource RailButton}" automation:AutomationProperties.Name="Open Modules Home"><Path Data="{StaticResource IconHome}" Stroke="#A9B6CC" StrokeThickness="1.7" Stretch="Uniform"/></Button><Button ToolTip="Global Search" Tag="Operations Center" Click="OpenGlobalSearch_Click" Style="{StaticResource RailButton}" automation:AutomationProperties.Name="Open Global Search"><Path Data="{StaticResource IconSearch}" Stroke="#A9B6CC" StrokeThickness="1.7" Stretch="Uniform"/></Button></StackPanel>
            <StackPanel DockPanel.Dock="Bottom" Margin="4,0,4,10"><Button ToolTip="Help" Click="OpenHelp_Click" Style="{StaticResource RailButton}" automation:AutomationProperties.Name="Open Help"><Path Data="{StaticResource IconHelp}" Stroke="#A9B6CC" StrokeThickness="1.7" Stretch="Uniform"/></Button><Button ToolTip="Settings" Tag="Admin / Settings" Click="Navigate_Click" Style="{StaticResource RailButton}" automation:AutomationProperties.Name="Open Settings"><Path Data="{StaticResource IconSettings}" Stroke="#A9B6CC" StrokeThickness="1.7" Stretch="Uniform"/></Button><Button ToolTip="Profile" Click="OpenProfile_Click" Style="{StaticResource RailButton}" automation:AutomationProperties.Name="Open Profile"><Path Data="{StaticResource IconUser}" Stroke="#A9B6CC" StrokeThickness="1.7" Stretch="Uniform"/></Button></StackPanel>
        </DockPanel>
        <Border x:Name="ContextSidebar" Grid.Column="1" Background="#FBFCFE" BorderBrush="{StaticResource Divider}" BorderThickness="0,0,1,0" Panel.ZIndex="20" automation:AutomationProperties.Name="Contextual module navigation">
            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Margin="16,18,16,12"><DockPanel><Button DockPanel.Dock="Right" Content="‹" Width="40" Padding="0" Click="ToggleSidebar_Click" ToolTip="Collapse sidebar" automation:AutomationProperties.Name="Collapse contextual sidebar"/><StackPanel><TextBlock x:Name="SidebarModuleTitle" Text="Modules" FontSize="19" FontWeight="SemiBold" Foreground="{StaticResource PrimaryText}"/><TextBlock x:Name="SidebarModuleSubtitle" Text="Choose a workspace" Style="{StaticResource CaptionText}"/></StackPanel></DockPanel><TextBox x:Name="SidebarSearchInput" Margin="0,14,0,0" TextChanged="SidebarSearch_TextChanged" automation:AutomationProperties.Name="Find a page or report" ToolTip="Find a page or report"/></StackPanel>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="SidebarItemsPanel" Margin="8,0,8,12"/></ScrollViewer>
                <Button Grid.Row="2" Content="← Back to Modules" Click="ShowModuleHome_Click" Style="{StaticResource SidebarItemButton}" Margin="12" automation:AutomationProperties.Name="Back to Modules Home"/>
            </Grid>
        </Border>
        <Grid Grid.Column="2">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Border Grid.Row="0" Background="{StaticResource Surface}" BorderBrush="{StaticResource Divider}" BorderThickness="0,0,0,1" Padding="24,14">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button x:Name="SidebarToggleButton" Width="44" Padding="12" Margin="0,0,12,0" Click="ToggleSidebar_Click" Visibility="Collapsed" automation:AutomationProperties.Name="Open contextual sidebar"><Path Data="M2,4 L18,4 M2,10 L18,10 M2,16 L18,16" Stroke="{StaticResource PrimaryText}" StrokeThickness="1.8" Stretch="Uniform"/></Button><StackPanel Grid.Column="1"><TextBlock x:Name="BreadcrumbText" Text="Modules" Style="{StaticResource CaptionText}"/><TextBlock x:Name="PageTitle" Text="Home" Style="{StaticResource PageTitleText}"/><TextBlock x:Name="PageDescription" Text="Choose a module to begin." Margin="0,2,0,0" Foreground="{StaticResource SecondaryText}"/></StackPanel><StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><ComboBox x:Name="ShellStoreSelector" Width="130" SelectedIndex="0" Margin="0,0,8,0" automation:AutomationProperties.Name="Current store"><ComboBoxItem Content="Titan World"/><ComboBoxItem Content="Helios"/><ComboBoxItem Content="Combined"/></ComboBox><DatePicker x:Name="ShellBusinessDateSelector" Width="145" SelectedDateChanged="ShellBusinessDate_Changed" Margin="0,0,12,0" automation:AutomationProperties.Name="Business date"/><TextBlock x:Name="AccessStatus" Text="Access: checking…" VerticalAlignment="Center" Foreground="{StaticResource SecondaryText}" automation:AutomationProperties.Name="Current application access"/></StackPanel></Grid>
            </Border>
            <ScrollViewer x:Name="LegacyWorkspaceScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="WorkspaceStack" Margin="24">
                    <UniformGrid x:Name="ReadinessSummaryPanel" Columns="2" Margin="0,0,0,20">
                        <Border Style="{StaticResource Card}" Margin="0,0,10,0"><StackPanel><TextBlock Text="Database connection" FontWeight="SemiBold" Foreground="#344454"/><TextBlock x:Name="ConnectionStatus" Text="Not configured" FontSize="20" FontWeight="SemiBold" Foreground="#9B5C00" Margin="0,10,0,4" automation:AutomationProperties.Name="Database connection status: Not configured"/><TextBlock Text="Configure SQL Server in Settings before importing data." TextWrapping="Wrap" Foreground="#5D6873"/></StackPanel></Border>
                        <Border Style="{StaticResource Card}" Margin="10,0,0,0"><StackPanel><TextBlock Text="Import readiness" FontWeight="SemiBold" Foreground="#344454"/><TextBlock x:Name="ImportStatus" Text="Waiting for configuration" FontSize="20" FontWeight="SemiBold" Foreground="#9B5C00" Margin="0,10,0,4" automation:AutomationProperties.Name="Import readiness status: Waiting for configuration"/><TextBlock Text="No workbook has been selected. Unknown layouts will never be guessed." TextWrapping="Wrap" Foreground="#5D6873"/></StackPanel></Border>
                    </UniformGrid>
                    <Border x:Name="GettingStartedPanel" Style="{StaticResource Card}"><StackPanel><TextBlock x:Name="WorkspaceHeading" Text="Getting started" FontSize="18" FontWeight="SemiBold" Foreground="#172B3E"/><TextBlock x:Name="WorkspaceMessage" Text="Open Settings to configure the database, then use Import ETP to select and validate a workbook." TextWrapping="Wrap" Margin="0,10,0,18" Foreground="#44515E"/><Button x:Name="PrimaryAction" Content="Open Settings" Tag="Settings" Click="Navigate_Click" HorizontalAlignment="Left" Style="{StaticResource PrimaryButton}" automation:AutomationProperties.Name="Open Settings"/></StackPanel></Border>
                    <Border x:Name="DashboardPanel" Style="{StaticResource Card}" Margin="0,20,0,0">
                        <ContentControl x:Name="DashboardHost"/>
                    </Border>
                    <Border x:Name="SettingsPanel" Style="{StaticResource Card}" Margin="0,20,0,0" Visibility="Collapsed">
                        <StackPanel><TextBlock Text="SQL Server connection string" FontWeight="SemiBold"/><TextBox x:Name="ConnectionStringInput" Margin="0,8,0,12" Padding="8" Text="Server=.\SQLEXPRESS;Database=EtpReporting;Integrated Security=True;TrustServerCertificate=True"/><StackPanel Orientation="Horizontal"><Button Content="Test connection" Click="TestConnection_Click" Padding="18,9"/><Button Content="Create/update database" Click="BootstrapDatabase_Click" Padding="18,9" Margin="10,0,0,0"/></StackPanel><TextBlock x:Name="ConnectionResult" Margin="0,12,0,0" TextWrapping="Wrap"/><Separator Margin="0,16,0,12"/><TextBlock Text="Product integrations" FontWeight="SemiBold"/><TextBlock Text="Local paths contain no passwords. OCR is optional and reporting remains available when it is not configured." Foreground="#5D6873" Margin="0,4,0,8" TextWrapping="Wrap"/><TextBlock Text="Document repository"/><TextBox x:Name="DocumentRepositoryInput" Padding="6" Margin="0,3,0,6"/><TextBlock Text="Share folder"/><TextBox x:Name="ShareFolderInput" Padding="6" Margin="0,3,0,6"/><TextBlock Text="PaddleOCR helper (optional)"/><TextBox x:Name="OcrHelperInput" Padding="6" Margin="0,3,0,6"/><TextBlock Text="PaddleOCR model folder (optional)"/><TextBox x:Name="OcrModelInput" Padding="6" Margin="0,3,0,6"/><WrapPanel><TextBox x:Name="SmtpHostInput" Width="190" Padding="6" ToolTip="Optional SMTP host metadata"/><TextBox x:Name="SmtpPortInput" Width="80" Padding="6" Margin="8,0,0,0" ToolTip="SMTP port"/><TextBox x:Name="SmtpFromInput" Width="230" Padding="6" Margin="8,0,0,0" ToolTip="From address"/><TextBox x:Name="MaximumAttachmentInput" Width="100" Padding="6" Margin="8,0,0,0" ToolTip="Maximum attachment MB"/><TextBox x:Name="ProductSettingsReasonInput" Width="230" Padding="6" Margin="8,0,0,0" ToolTip="Owner change reason"/><Button Content="Save integrations" Click="SaveProductSettings_Click" Padding="14,7" Margin="8,0,0,0"/></WrapPanel></StackPanel>
                    </Border>
                    <Border x:Name="DailyWorkflowPanel" Style="{StaticResource Card}" Margin="0,20,0,0" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="Business-date reporting workflow" FontSize="18" FontWeight="SemiBold"/>
                            <TextBlock Text="ETP transaction/report dates control FTD, MTD and YTD. Import timestamps never change the business date." Margin="0,6,0,12" Foreground="#5D6873" TextWrapping="Wrap"/>
                            <WrapPanel>
                                <TextBlock Text="Business date" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <DatePicker x:Name="DailyBusinessDateInput" Width="145" automation:AutomationProperties.Name="Daily workflow business date"/>
                                <TextBlock Text="Store" VerticalAlignment="Center" Margin="14,0,6,0"/>
                                <ComboBox x:Name="DailyStoreInput" Width="160" SelectedIndex="0" automation:AutomationProperties.Name="Daily workflow store">
                                    <ComboBoxItem Content="WLMHW"/><ComboBoxItem Content="HEMW"/>
                                </ComboBox>
                                <Button Content="Refresh status" Click="RefreshDailyWorkflow_Click" Padding="14,7" Margin="12,0,0,0" automation:AutomationProperties.Name="Refresh daily workflow"/>
                            </WrapPanel>
                            <Border Background="#F3F5F7" CornerRadius="4" Padding="12" Margin="0,14,0,12">
                                <StackPanel><TextBlock x:Name="DailyWorkflowStatus" Text="Select a business date and refresh." FontSize="17" FontWeight="SemiBold" automation:AutomationProperties.LiveSetting="Polite"/><TextBlock x:Name="DailyWorkflowMessage" Margin="0,5,0,0" TextWrapping="Wrap"/><TextBlock x:Name="DailySourceStatus" Margin="0,8,0,0" TextWrapping="Wrap"/><TextBlock x:Name="DailyInputStatus" Margin="0,4,0,0" TextWrapping="Wrap"/></StackPanel>
                            </Border>
                            <TextBlock x:Name="ManualEntrySection" Text="Manual Entry" FontSize="18" FontWeight="SemiBold"/>
                            <TextBlock Text="Enter values that are not available in ETP reports. Walk-ins feed the combined conversion calculation; zero remains different from missing. Every change requires a reason and remains audited." Margin="0,4,0,0" Foreground="{StaticResource SecondaryText}" TextWrapping="Wrap"/>
                            <DataGrid x:Name="DailyManualInputsGrid" Margin="0,8,0,10" AutoGenerateColumns="True" IsReadOnly="True" MaxHeight="210" automation:AutomationProperties.Name="Daily manual operational inputs"/>
                            <WrapPanel>
                                <ComboBox x:Name="ManualFieldInput" Width="220" DisplayMemberPath="DisplayName" SelectedValuePath="FieldCode" automation:AutomationProperties.Name="Manual input field"/>
                                <TextBox x:Name="ManualValueInput" Width="150" Padding="6" Margin="8,0,0,0" ToolTip="Value; enter zero when the measured result is zero" automation:AutomationProperties.Name="Manual input value"/>
                                <TextBox x:Name="ManualReasonInput" Width="260" Padding="6" Margin="8,0,0,0" ToolTip="Required reason, for example Daily store count" automation:AutomationProperties.Name="Manual input change reason"/>
                                <Button Content="Save input" Click="SaveManualInput_Click" Padding="14,7" Margin="8,0,0,0" automation:AutomationProperties.Name="Save manual input"/>
                            </WrapPanel>
                            <TextBlock Text="Physical stock by inventory group" FontWeight="SemiBold" Margin="0,14,0,0"/>
                            <TextBlock Text="Enter component counts and the independently counted physical total. The engine shows both composition variance and physical-versus-system variance." Margin="0,4,0,6" Foreground="#5D6873" TextWrapping="Wrap"/>
                            <DataGrid x:Name="DailyStockCountsGrid" AutoGenerateColumns="True" IsReadOnly="True" MaxHeight="150" automation:AutomationProperties.Name="Physical stock counts by inventory group"/>
                            <WrapPanel Margin="0,8,0,0">
                                <TextBox x:Name="StockGroupInput" Width="130" Padding="6" ToolTip="Inventory group, CLUSTER, brand or controlled group code" automation:AutomationProperties.Name="Inventory group code"/>
                                <TextBox x:Name="StockDisplayInput" Width="78" Padding="6" Margin="6,0,0,0" ToolTip="Display quantity" automation:AutomationProperties.Name="Display quantity"/>
                                <TextBox x:Name="StockBackstockInput" Width="78" Padding="6" Margin="6,0,0,0" ToolTip="Backstock quantity" automation:AutomationProperties.Name="Backstock quantity"/>
                                <TextBox x:Name="StockDefectiveInput" Width="78" Padding="6" Margin="6,0,0,0" ToolTip="Defective quantity" automation:AutomationProperties.Name="Defective quantity"/>
                                <TextBox x:Name="StockYLocationInput" Width="78" Padding="6" Margin="6,0,0,0" ToolTip="Y-location quantity" automation:AutomationProperties.Name="Y location quantity"/>
                                <TextBox x:Name="StockPhysicalInput" Width="90" Padding="6" Margin="6,0,0,0" ToolTip="Independently counted physical quantity" automation:AutomationProperties.Name="Counted physical quantity"/>
                                <TextBox x:Name="StockRemarksInput" Width="150" Padding="6" Margin="6,0,0,0" ToolTip="Stock remarks" automation:AutomationProperties.Name="Stock remarks"/>
                                <TextBox x:Name="StockReasonInput" Width="160" Padding="6" Margin="6,0,0,0" ToolTip="Required change reason" automation:AutomationProperties.Name="Stock count change reason"/>
                                <Button Content="Save stock count" Click="SaveStockCount_Click" Padding="12,7" Margin="6,0,0,0" automation:AutomationProperties.Name="Save physical stock count"/>
                            </WrapPanel>
                            <TextBlock Text="Staff/CRO target" FontWeight="SemiBold" Margin="0,14,0,0"/>
                            <WrapPanel Margin="0,6,0,0">
                                <TextBox x:Name="StaffTargetCroInput" Width="120" Padding="6" ToolTip="CRO number" automation:AutomationProperties.Name="Staff CRO number"/>
                                <DatePicker x:Name="StaffTargetFromInput" Width="140" Margin="6,0,0,0" automation:AutomationProperties.Name="Staff target start date"/>
                                <DatePicker x:Name="StaffTargetToInput" Width="140" Margin="6,0,0,0" automation:AutomationProperties.Name="Staff target end date"/>
                                <TextBox x:Name="StaffTargetValueInput" Width="110" Padding="6" Margin="6,0,0,0" ToolTip="Target sales" automation:AutomationProperties.Name="Staff target sales"/>
                                <TextBox x:Name="StaffTargetReasonInput" Width="210" Padding="6" Margin="6,0,0,0" ToolTip="Required change reason" automation:AutomationProperties.Name="Staff target change reason"/>
                                <Button Content="Save target" Click="SaveStaffTarget_Click" Padding="12,7" Margin="6,0,0,0" automation:AutomationProperties.Name="Save staff target"/>
                            </WrapPanel>
                            <WrapPanel Margin="0,14,0,0">
                                <Button x:Name="FinaliseDayButton" Content="Finalise day" Click="FinaliseDay_Click" Padding="16,8" IsEnabled="False" automation:AutomationProperties.Name="Finalise business day"/>
                                <TextBox x:Name="ReopenReasonInput" Width="280" Padding="6" Margin="12,0,0,0" ToolTip="Administrator reason required to reopen" automation:AutomationProperties.Name="Reopen reason"/>
                                <Button Content="Reopen day" Click="ReopenDay_Click" Padding="16,8" Margin="8,0,0,0" automation:AutomationProperties.Name="Reopen finalised business day"/>
                            </WrapPanel>
                            <WrapPanel Margin="0,14,0,0"><Button Content="Generate selected-store pack" Click="GenerateDailyPack_Click" Padding="16,8" automation:AutomationProperties.Name="Generate selected store daily reporting pack"/><Button Content="Generate Titan + Helios pack" Click="GenerateCombinedDailyPack_Click" Padding="16,8" Margin="8,0,0,0" automation:AutomationProperties.Name="Generate combined Titan and Helios daily reporting pack"/><Button Content="Export complete pack Excel…" Click="ExportDailyPackExcel_Click" Padding="16,8" Margin="8,0,0,0" automation:AutomationProperties.Name="Export complete report pack Excel"/><Button Content="Export complete pack PDF…" Click="ExportDailyPackPdf_Click" Padding="16,8" Margin="8,0,0,0" automation:AutomationProperties.Name="Export complete report pack PDF"/></WrapPanel>
                            <DataGrid x:Name="DailyPackGrid" Margin="0,10,0,0" AutoGenerateColumns="True" IsReadOnly="True" MaxHeight="260" automation:AutomationProperties.Name="Daily reporting pack status"/>
                        </StackPanel>
                    </Border>
                    <Border x:Name="ImportPanel" Style="{StaticResource Card}" Margin="0,20,0,0" Visibility="Collapsed">
                        <StackPanel><TextBlock Text="ETP import source" FontWeight="SemiBold"/><WrapPanel Margin="0,8,0,10"><TextBlock Text="Business date" VerticalAlignment="Center" Margin="0,0,6,0"/><DatePicker x:Name="ImportBusinessDateInput" Width="145" automation:AutomationProperties.Name="Import business date"/><TextBlock Text="Store" VerticalAlignment="Center" Margin="14,0,6,0"/><ComboBox x:Name="ImportStoreInput" Width="150" SelectedIndex="0" automation:AutomationProperties.Name="Import store"><ComboBoxItem Content="WLMHW"/><ComboBoxItem Content="HEMW"/></ComboBox></WrapPanel><WrapPanel Margin="0,0,0,10"><CheckBox x:Name="RestatementModeInput" Content="Controlled restatement of the current source" VerticalAlignment="Center" automation:AutomationProperties.Name="Controlled import restatement"/><TextBox x:Name="RestatementReasonInput" Width="360" Padding="6" Margin="10,0,0,0" ToolTip="Required reason; the finalised day must be reopened first" automation:AutomationProperties.Name="Import restatement reason"/></WrapPanel><DockPanel Margin="0,8,0,12"><WrapPanel DockPanel.Dock="Right"><Button Content="Browse workbook/ZIP…" Click="BrowseWorkbook_Click" Padding="14,7" automation:AutomationProperties.Name="Browse workbook or ZIP"/><Button Content="Browse folder…" Click="BrowseImportFolder_Click" Padding="14,7" Margin="8,0,0,0" automation:AutomationProperties.Name="Browse import folder"/></WrapPanel><TextBox x:Name="WorkbookPathInput" IsReadOnly="True" Padding="8" Margin="0,0,10,0" automation:AutomationProperties.Name="Selected import source"/></DockPanel><WrapPanel><Button x:Name="ValidateButton" Content="Validate workbook" Click="ValidateWorkbook_Click" Padding="18,9"/><Button x:Name="PersistButton" Content="Import validated rows" Click="PersistWorkbook_Click" Padding="18,9" Margin="10,0,0,0" IsEnabled="False"/><Button x:Name="StartBatchButton" Content="Import batch" Click="StartBatchImport_Click" Padding="18,9" Margin="10,0,0,0"/><Button x:Name="CancelBatchButton" Content="Cancel" Click="CancelBatchImport_Click" Padding="18,9" Margin="10,0,0,0" IsEnabled="False"/><Button x:Name="RetryBatchButton" Content="Retry failed" Click="RetryBatchImport_Click" Padding="18,9" Margin="10,0,0,0" IsEnabled="False"/></WrapPanel><ProgressBar x:Name="ImportProgressBar" Height="10" Margin="0,12,0,0" Minimum="0" Maximum="1" automation:AutomationProperties.Name="Import progress"/><TextBlock x:Name="ValidationResult" Margin="0,12,0,0" TextWrapping="Wrap" automation:AutomationProperties.LiveSetting="Polite"/><DataGrid x:Name="DiagnosticsGrid" Margin="0,12,0,0" AutoGenerateColumns="True" IsReadOnly="True" MaxHeight="180"/><DataGrid x:Name="BatchResultsGrid" Margin="0,12,0,0" AutoGenerateColumns="True" IsReadOnly="True" MaxHeight="220" automation:AutomationProperties.Name="Batch import results"/></StackPanel>
                    </Border>
                    <Border x:Name="SourceInboxPanel" Style="{StaticResource Card}" Margin="0,20,0,0" Visibility="Collapsed">
                        <StackPanel>
                            <DockPanel><StackPanel><TextBlock Text="Source Inbox" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Every workbook, ZIP, PDF and image remains traceable from receipt through import, review or quarantine." Foreground="#5D6873" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel><Button DockPanel.Dock="Right" Content="Refresh inbox" Click="RefreshSourceInbox_Click" Padding="14,7" automation:AutomationProperties.Name="Refresh Source Inbox"/></DockPanel>
                            <WrapPanel Margin="0,12,0,8"><ComboBox x:Name="SourceInboxStatusInput" Width="170" SelectedIndex="0" automation:AutomationProperties.Name="Source Inbox status filter"><ComboBoxItem Content="All"/><ComboBoxItem Content="Received"/><ComboBoxItem Content="Review Required"/><ComboBoxItem Content="Imported"/><ComboBoxItem Content="Duplicate"/><ComboBoxItem Content="Conflict"/><ComboBoxItem Content="Quarantined"/></ComboBox><Button Content="Add PDF or image…" Click="BrowseSourceDocument_Click" Padding="14,7" Margin="8,0,0,0" automation:AutomationProperties.Name="Add PDF or image to Source Inbox"/><Button Content="Verify/open selected" Click="OpenSourceDocument_Click" Padding="14,7" Margin="8,0,0,0" automation:AutomationProperties.Name="Verify and open selected source document"/><TextBox x:Name="SourceDocumentPathInput" Width="280" IsReadOnly="True" Padding="6" Margin="8,0,0,0" automation:AutomationProperties.Name="Selected source document"/></WrapPanel>
                            <WrapPanel Margin="0,0,0,8"><TextBox x:Name="SourceDocumentStoreInput" Width="110" Padding="6" ToolTip="Store code" automation:AutomationProperties.Name="Document store"/><DatePicker x:Name="SourceDocumentDateInput" Width="145" Margin="8,0,0,0" automation:AutomationProperties.Name="Document business date"/><ComboBox x:Name="SourceDocumentTypeInput" Width="180" SelectedIndex="0" Margin="8,0,0,0" automation:AutomationProperties.Name="Document type"><ComboBoxItem Content="Inward Invoice"/><ComboBoxItem Content="Vendor Invoice"/><ComboBoxItem Content="Credit Note"/><ComboBoxItem Content="Stock Transfer"/><ComboBoxItem Content="Other"/></ComboBox><Button Content="Store and extract" Click="IntakeSourceDocument_Click" Padding="14,7" Margin="8,0,0,0" automation:AutomationProperties.Name="Store document and extract text"/></WrapPanel>
                            <TextBlock x:Name="SourceInboxStatus" Text="Refresh to view received sources." TextWrapping="Wrap" automation:AutomationProperties.LiveSetting="Polite"/><DataGrid x:Name="SourceInboxGrid" AutoGenerateColumns="True" IsReadOnly="True" SelectionChanged="SourceInbox_SelectionChanged" MaxHeight="260" Margin="0,8,0,0" automation:AutomationProperties.Name="Source Inbox documents"/>
                            <TextBlock Text="Extraction review" FontWeight="SemiBold" Margin="0,12,0,6"/><DataGrid x:Name="DocumentExtractionGrid" AutoGenerateColumns="True" IsReadOnly="True" SelectionMode="Single" MaxHeight="190" automation:AutomationProperties.Name="Document extraction review"/>
                            <WrapPanel Margin="0,8,0,0"><TextBox x:Name="ExtractionReviewReasonInput" Width="360" Padding="6" ToolTip="Required human review note" automation:AutomationProperties.Name="Extraction review reason"/><Button Content="Verify extraction" Click="VerifyExtraction_Click" Padding="14,7" Margin="8,0,0,0"/><Button Content="Reject and quarantine" Click="RejectExtraction_Click" Padding="14,7" Margin="8,0,0,0"/></WrapPanel>
                        </StackPanel>
                    </Border>
                    <Border x:Name="ReportsPanel" Style="{StaticResource Card}" Margin="0,20,0,0" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="Report period and filters" FontWeight="SemiBold"/>
                            <WrapPanel Margin="0,8,0,6"><DatePicker x:Name="ReportFrom" Width="145"/><TextBlock Text="to" Margin="8,5"/><DatePicker x:Name="ReportTo" Width="145"/><ComboBox x:Name="SalesDimensionInput" Width="160" Margin="10,0,0,0" SelectedIndex="0"><ComboBoxItem Content="Daily"/><ComboBoxItem Content="Store"/><ComboBoxItem Content="Brand"/><ComboBoxItem Content="BrandSegment"/><ComboBoxItem Content="Item"/><ComboBoxItem Content="Returns"/></ComboBox></WrapPanel>
                            <WrapPanel Margin="0,0,0,8"><TextBox x:Name="StoreFilterInput" Width="120" Padding="6" Margin="0,0,8,0" ToolTip="Store codes, comma-separated" automation:AutomationProperties.Name="Store filter"/><TextBox x:Name="BrandSegmentFilterInput" Width="145" Padding="6" Margin="0,0,8,0" ToolTip="Brand segments, comma-separated" automation:AutomationProperties.Name="Brand segment filter"/><TextBox x:Name="TransactionTypeFilterInput" Width="145" Padding="6" Margin="0,0,8,0" ToolTip="Transaction types, comma-separated" automation:AutomationProperties.Name="Transaction type filter"/><TextBox x:Name="ItemFilterInput" Width="145" Padding="6" ToolTip="Item codes, comma-separated" automation:AutomationProperties.Name="Item filter"/></WrapPanel>
                            <TextBlock Text="Sales" FontSize="17" FontWeight="SemiBold" Margin="0,10,0,5"/>
